<Window x:Class="SfUi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{loc:Tr App_Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="720" Width="1520" MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="IconFill" Color="#3A3A3A" />
        <!-- アイコンのみのボタン（ツールチップでラベルと説明を表示） -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <DockPanel>

        <!-- 上部バー: 組織/フォルダ切替とツール起動（Phase 1 / Phase 4 で機能実装） -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr Main_OrgLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="OrgComboBox" Width="215" Margin="0,0,6,0"
                          ItemsSource="{Binding Orgs}"
                          SelectedItem="{Binding SelectedOrg, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{loc:Tr Main_OrgTooltip}" />
                <Button Style="{StaticResource IconButton}" Margin="0,0,12,0"
                        Command="{Binding RefreshOrgsCommand}"
                        ToolTip="{loc:Tr Main_RefreshOrgsTip}"
                        AutomationProperties.Name="{loc:Tr Main_RefreshOrgsTip}">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconArrowClockwise}" />
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                        Command="{Binding OpenOrgInfoCommand}"
                        IsEnabled="{Binding HasSelectedOrg}"
                        AutomationProperties.Name="{loc:Tr Main_OrgInfo}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconInfo}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_OrgInfo}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_OrgInfoTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                        Command="{Binding OpenCompareOrgsCommand}"
                        IsEnabled="{Binding CanCompareOrgs}"
                        AutomationProperties.Name="{loc:Tr Main_Compare}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconCompare}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_Compare}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_CompareTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,10,0"
                        Command="{Binding OpenDataIoCommand}"
                        IsEnabled="{Binding HasSelectedOrg}"
                        AutomationProperties.Name="{loc:Tr Main_DataIo}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconDataIo}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_DataIo}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_DataIoTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                </Button>

                <TextBlock Text="{loc:Tr Main_FolderLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FolderComboBox" Width="230" IsEditable="True" Margin="0,0,4,0"
                          ItemsSource="{Binding RecentFolders}"
                          DisplayMemberPath="Path"
                          Text="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="FolderComboBox_SelectionChanged"
                          KeyDown="FolderComboBox_KeyDown"
                          LostKeyboardFocus="FolderComboBox_LostFocus"
                          ToolTip="{loc:Tr Main_FolderTooltip}" />
                <Button Style="{StaticResource IconButton}" Margin="0,0,8,0"
                        Command="{Binding BrowseFolderCommand}"
                        AutomationProperties.Name="{loc:Tr Main_Browse}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconFolderSearch}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_Browse}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_BrowseTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                </Button>

                <Border Width="1" Background="#CCCCCC" Margin="0,2,8,2" />

                <Button Style="{StaticResource IconButton}" Margin="0,0,6,0"
                        Command="{Binding OpenTerminalCommand}"
                        AutomationProperties.Name="{loc:Tr Main_Terminal}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconTerminal}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_Terminal}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_TerminalTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Tr Main_TermWt}" Command="{Binding OpenTerminalCommand}" />
                            <MenuItem Header="{loc:Tr Main_TermPs}" Command="{Binding OpenTerminalCommand}" CommandParameter="powershell" />
                            <MenuItem Header="{loc:Tr Main_TermCmd}" Command="{Binding OpenTerminalCommand}" CommandParameter="cmd" />
                            <MenuItem Header="{loc:Tr Main_TermWsl}" Command="{Binding OpenTerminalCommand}" CommandParameter="wsl" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,6,0"
                        Command="{Binding OpenExplorerCommand}"
                        AutomationProperties.Name="{loc:Tr Main_Explorer}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconFolderOpen}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_Explorer}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_ExplorerTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Tr Main_OpenFolder}" Command="{Binding OpenExplorerCommand}" />
                            <MenuItem Header="{loc:Tr Main_CopyPath}" Command="{Binding OpenExplorerCommand}" CommandParameter="copy-path" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,6,0"
                        Command="{Binding OpenVsCodeCommand}"
                        AutomationProperties.Name="{loc:Tr Main_VsCode}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconCode}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_VsCode}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_VsCodeTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Tr Main_VsCodeNew}" Command="{Binding OpenVsCodeCommand}" />
                            <MenuItem Header="{loc:Tr Main_VsCodeReuse}" Command="{Binding OpenVsCodeCommand}" CommandParameter="reuse" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Style="{StaticResource IconButton}" Margin="0,0,6,0"
                        Command="{Binding OpenBrowserCommand}"
                        AutomationProperties.Name="{loc:Tr Main_Browser}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconGlobe}" />
                    <Button.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_Browser}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_BrowserTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{loc:Tr Main_BrowserHome}" Command="{Binding OpenBrowserCommand}" />
                            <MenuItem Header="{loc:Tr Main_BrowserSetup}" Command="{Binding OpenBrowserCommand}" CommandParameter="org-setup" />
                            <MenuItem Header="{loc:Tr Main_BrowserLogin}" Command="{Binding OpenBrowserCommand}" CommandParameter="login" />
                            <Separator />
                            <MenuItem Header="{loc:Tr Main_BrowserInput}" Command="{Binding OpenBrowserCommand}" CommandParameter="input" />
                            <MenuItem Header="{loc:Tr Main_BrowserRecent}" ItemsSource="{Binding RecentUrls}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding DisplayText}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Border Width="1" Background="#CCCCCC" Margin="12,2,12,2" />

                <ToggleButton Style="{StaticResource IconToggleButton}"
                              IsChecked="{Binding IsQuickPanelVisible, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Tr Main_QuickToggle}">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}" Data="{StaticResource IconPanelLeft}" />
                    <ToggleButton.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{loc:Tr Main_QuickToggle}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_QuickToggleTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </ToggleButton.ToolTip>
                </ToggleButton>

                <ToggleButton Style="{StaticResource IconToggleButton}" Margin="6,0,0,0"
                              IsChecked="{Binding IsAiPanelVisible, Mode=TwoWay}"
                              AutomationProperties.Name="AI">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconFill}">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource IconSparkle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource IconSparkleFilled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <ToggleButton.ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="AI" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Main_AiToggleTip}" TextWrapping="Wrap" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </ToggleButton.ToolTip>
                </ToggleButton>

                <ComboBox Width="96" Margin="6,0,0,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding LanguageLabels}"
                          SelectedItem="{Binding LanguageLabel, Mode=TwoWay}"
                          ToolTip="{loc:Tr Main_LanguageTip}" />
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="White" />
                    <TextBlock Text="{Binding StatusDetail}" Foreground="#CFE8FF" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="DataPathText" Text="" Foreground="#CFE8FF"
                           HorizontalAlignment="Right" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" x:Name="VersionText" Text="" Foreground="White" />
            </Grid>
        </Border>

        <!-- クイックパネル（お気に入り）: 左サイド -->
        <Border DockPanel.Dock="Left" Width="240" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0"
                Visibility="{Binding IsQuickPanelVisible, Converter={StaticResource BoolToVis}}">
            <views:QuickPanelView DataContext="{Binding QuickPanel}" />
        </Border>

        <!-- AI パネル: 右サイド -->
        <Border DockPanel.Dock="Right" Width="400" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0"
                Visibility="{Binding IsAiPanelVisible, Converter={StaticResource BoolToVis}}">
            <views:AiChatView DataContext="{Binding Ai}" />
        </Border>

        <!-- メイン: 機能タブ（各 Phase で実装） -->
        <TabControl Margin="8" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{loc:Tr Tab_Soql}">
                <views:SoqlView DataContext="{Binding Soql}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Apex}">
                <views:ApexView DataContext="{Binding Apex}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Log}">
                <views:LogView DataContext="{Binding Logs}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_History}">
                <views:HistoryView DataContext="{Binding History}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Deploy}">
                <views:DeployView DataContext="{Binding Deploy}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Command}">
                <views:CommandView DataContext="{Binding Command}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Api}">
                <views:ApiConsoleView DataContext="{Binding Api}" />
            </TabItem>
            <TabItem Header="{loc:Tr Tab_Settings}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="SfUi.App.Views.ReportEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="800" Width="1000" MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding LabelSave}" MinWidth="110" Padding="12,4" IsDefault="True" Click="OnSave"
                        AutomationProperties.AutomationId="ReportEditorSave" />
                <Button Content="{Binding LabelCancel}" MinWidth="90" Padding="12,4" Margin="8,0,0,0" IsCancel="True"
                        AutomationProperties.AutomationId="ReportEditorCancel" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10,16,10">
            <StackPanel>
                <!-- 基本 -->
                <TextBlock Text="{Binding LabelName}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="ReportEditorName" />

                <TextBlock Text="{Binding LabelDescription}" Style="{StaticResource FieldLabel}" Margin="0,8,0,3" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="ReportEditorDescription" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding LabelObject}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                                  DisplayMemberPath="Display" AutomationProperties.AutomationId="ReportEditorObject" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding LabelDisplayMode}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}"
                                  DisplayMemberPath="Label" AutomationProperties.AutomationId="ReportEditorDisplayMode" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding LabelRowLimit}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RowLimitText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ReportEditorRowLimit" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding LabelRefresh}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RefreshText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ReportEditorRefresh" />
                    </StackPanel>
                    <CheckBox Grid.Column="3" Content="{Binding LabelBulk}" IsChecked="{Binding UseBulk}"
                              VerticalAlignment="Bottom" Margin="12,0,0,2"
                              AutomationProperties.AutomationId="ReportEditorBulk" />
                </Grid>

                <!-- グラフ -->
                <TextBlock Text="{Binding LabelChartType}" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ComboBox ItemsSource="{Binding ChartTypes}" SelectedItem="{Binding ChartType}"
                                  DisplayMemberPath="Label" AutomationProperties.AutomationId="ReportEditorChartType" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Visibility="{Binding IsChartEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LabelChartCategory}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ChartFields}" SelectedItem="{Binding ChartCategory}"
                                  AutomationProperties.AutomationId="ReportEditorChartCategory" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Visibility="{Binding IsChartEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LabelChartValue}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ChartFields}" SelectedItem="{Binding ChartValue}"
                                  AutomationProperties.AutomationId="ReportEditorChartValue" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Visibility="{Binding IsChartEnabled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LabelChartTopN}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ChartTopNText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ReportEditorChartTopN" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding IsChartEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding LabelChartTitle}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ChartTitle, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ReportEditorChartTitle" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Content="{Binding LabelChartLegend}" IsChecked="{Binding ChartLegend}"
                              VerticalAlignment="Bottom" Margin="0,0,0,2"
                              AutomationProperties.AutomationId="ReportEditorChartLegend" />
                </Grid>

                <!-- 列 -->
                <TextBlock Text="{Binding LabelColumns}" Style="{StaticResource SectionHeader}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding LabelAdd}" Command="{Binding AddColumnCommand}"
                            Style="{StaticResource SmallButton}" Padding="12,3"
                            AutomationProperties.AutomationId="ReportEditorAddColumn" />
                    <ComboBox ItemsSource="{Binding Fields}" SelectedItem="{Binding FieldPicker}" DisplayMemberPath="Display"
                              AutomationProperties.AutomationId="ReportEditorFieldPicker" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Columns}" MaxHeight="180" Margin="0,6,0,0"
                         AutomationProperties.AutomationId="ReportEditorColumns">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}"
                                          DisplayMemberPath="Display" />
                                <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"
                                          DisplayMemberPath="Label" Margin="6,0,0,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="&#x25B2;" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.MoveColumnUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="&#x25BC;" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.MoveColumnDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="&#x2715;" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.RemoveColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 条件 -->
                <TextBlock Text="{Binding LabelFilters}" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding LabelAdd}" Command="{Binding AddFilterCommand}" Style="{StaticResource SmallButton}"
                            AutomationProperties.AutomationId="ReportEditorAddFilter" />
                    <ComboBox ItemsSource="{Binding FilterLogics}" SelectedItem="{Binding FilterLogic}"
                              DisplayMemberPath="Label" Width="220" Margin="12,0,0,0"
                              AutomationProperties.AutomationId="ReportEditorFilterLogic" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Filters}" Margin="0,6,0,0" AutomationProperties.AutomationId="ReportEditorFilters">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}"
                                          DisplayMemberPath="Display" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}"
                                          DisplayMemberPath="Label" Margin="6,0,0,0" />
                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- グループ -->
                <TextBlock Text="{Binding LabelGroups}" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="ReportEditorGroups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}"
                                          DisplayMemberPath="Display" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Granularities}" SelectedItem="{Binding Granularity}"
                                          DisplayMemberPath="Label" Margin="6,0,0,0" />
                                <CheckBox Grid.Column="2" Content="DESC" IsChecked="{Binding IsDescending}" Margin="6,0,0,0"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 集計 -->
                <TextBlock Text="{Binding LabelAggregates}" Style="{StaticResource SectionHeader}" />
                <Button Content="{Binding LabelAdd}" Command="{Binding AddAggregateCommand}" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Left" AutomationProperties.AutomationId="ReportEditorAddAggregate" />
                <ItemsControl ItemsSource="{Binding Aggregates}" Margin="0,6,0,0" AutomationProperties.AutomationId="ReportEditorAggregates">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}"
                                          DisplayMemberPath="Display" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Functions}" SelectedItem="{Binding Function}"
                                          DisplayMemberPath="Label" Margin="6,0,0,0" />
                                <TextBox Grid.Column="2" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                                <Button Grid.Column="3" Content="&#x2715;" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.RemoveAggregateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 並べ替え -->
                <TextBlock Text="{Binding LabelSorts}" Style="{StaticResource SectionHeader}" />
                <Button Content="{Binding LabelAdd}" Command="{Binding AddSortCommand}" Style="{StaticResource SmallButton}"
                        HorizontalAlignment="Left" AutomationProperties.AutomationId="ReportEditorAddSort" />
                <ItemsControl ItemsSource="{Binding Sorts}" Margin="0,6,0,0" AutomationProperties.AutomationId="ReportEditorSorts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}" SelectedItem="{Binding Field}"
                                          DisplayMemberPath="Display" />
                                <CheckBox Grid.Column="1" Content="DESC" IsChecked="{Binding IsDescending}" Margin="6,0,0,0"
                                          VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource SmallButton}"
                                        Command="{Binding DataContext.RemoveSortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Hint}" Foreground="#777777" TextWrapping="Wrap" Margin="0,16,0,0" />
                <TextBlock Text="{Binding ErrorText}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="ReportEditorError" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

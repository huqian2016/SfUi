<UserControl x:Class="SfUi.App.Views.CompareCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ツールバー: 集計 + タブ内検索 + 読み込み中 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Tr Compare_SearchLabel}" Margin="16,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="FilterBox" Width="240" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="CompareFilterBox"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr Compare_SearchTip}" />
                <TextBlock Text="{Binding FilteredCountText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666666" />
                <TextBlock Text="{loc:Tr Compare_Loading}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666666"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- 差分のある行のみ黄色でハイライトする -->
                            <DataTrigger Binding="{Binding IsDiff}" Value="True">
                                <Setter Property="Background" Value="#FFF59D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
            <TextBlock Text="{Binding EmptyMessage}" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

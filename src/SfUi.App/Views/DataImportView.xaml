<UserControl x:Class="SfUi.App.Views.DataImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ファイルとオプション -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr DataImport_FileLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="FilePathBox" Width="380" VerticalContentAlignment="Center" IsReadOnly="True" Text="{Binding FilePath}" />
                    <Button Content="{loc:Tr DataImport_Browse}" Padding="10,2" Margin="6,0,0,0" Command="{Binding BrowseCommand}" />
                    <TextBlock Text="{loc:Tr DataImport_EncodingLabel}" VerticalAlignment="Center" Margin="14,0,4,0" />
                    <ComboBox x:Name="EncodingCombo" Width="110" SelectedIndex="{Binding EncodingIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Tr DataImport_EncodingAuto}" />
                        <ComboBoxItem Content="{loc:Tr DataImport_EncodingUtf8}" />
                        <ComboBoxItem Content="{loc:Tr DataImport_EncodingSjis}" />
                    </ComboBox>
                    <TextBlock Text="{Binding FileInfoText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555555" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{loc:Tr DataImport_OperationLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="OperationCombo" Width="110" SelectedIndex="{Binding OperationIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{loc:Tr DataImport_OpInsert}" />
                        <ComboBoxItem Content="{loc:Tr DataImport_OpUpdate}" />
                        <ComboBoxItem Content="{loc:Tr DataImport_OpUpsert}" />
                        <ComboBoxItem Content="{loc:Tr DataImport_OpDelete}" />
                    </ComboBox>
                    <TextBlock Text="{loc:Tr DataImport_ExtIdLabel}" VerticalAlignment="Center" Margin="14,0,4,0"
                               Visibility="{Binding ShowExternalId, Converter={StaticResource BoolToVis}}" />
                    <ComboBox x:Name="ExternalIdCombo" Width="200" ItemsSource="{Binding ExternalIdFields}" SelectedItem="{Binding ExternalIdField, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              Visibility="{Binding ShowExternalId, Converter={StaticResource BoolToVis}}" />
                    <CheckBox Content="{loc:Tr DataImport_EmptyAsNull}" VerticalAlignment="Center" Margin="18,0,0,0"
                              IsChecked="{Binding EmptyAsNull, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{loc:Tr DataIo_EngineLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <RadioButton Content="{loc:Tr DataIo_EngineRest}" Margin="0,0,12,0" IsChecked="{Binding UseRest, Mode=TwoWay}" />
                    <RadioButton Content="{loc:Tr DataIo_EngineBulk}" IsChecked="{Binding UseBulk, Mode=TwoWay}" />
                    <TextBlock Text="{loc:Tr DataImport_BulkNote}" Foreground="#777777" VerticalAlignment="Center" Margin="14,0,0,0"
                               Visibility="{Binding UseBulk, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel>
            <!-- マッピング -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,0">
                <Button Content="{loc:Tr DataImport_AutoMap}" Padding="10,2" Command="{Binding AutoMapCommand}" />
                <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="#555555" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataGrid x:Name="MappingGrid" DockPanel.Dock="Top" ItemsSource="{Binding Mappings}" Height="180" Margin="8,6,8,0"
                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{loc:Tr DataImport_MapUse}" Binding="{Binding Include, Mode=TwoWay}" Width="52" />
                    <DataGridTextColumn Header="{loc:Tr DataImport_MapColumn}" Binding="{Binding CsvColumn}" Width="170" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:Tr DataImport_MapSample}" Binding="{Binding Sample}" Width="220" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="{loc:Tr DataImport_MapField}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                          DisplayMemberPath="Display" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 実行 -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,0">
                <Button Content="{loc:Tr DataImport_Run}" Padding="12,2" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" />
                <Button Content="{loc:Tr Common_Cancel}" Padding="10,2" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsRunning}" />
                <TextBlock Text="{Binding ProgressText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555555" />
                <TextBlock Text="{Binding SummaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Content="{loc:Tr DataImport_SaveErrors}" Padding="10,2" Margin="12,0,0,0"
                        Command="{Binding SaveErrorsCommand}" IsEnabled="{Binding HasResults}" />
            </StackPanel>

            <!-- 結果 -->
            <DataGrid x:Name="ImportResultGrid" ItemsSource="{Binding Results}" Margin="8,6,8,8"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AlternatingRowBackground="#F7F7F7">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr DataImport_ResultRow}" Binding="{Binding RowText}" Width="64" />
                    <DataGridTextColumn Header="{loc:Tr DataImport_ResultStatus}" Binding="{Binding StatusText}" Width="88" />
                    <DataGridTextColumn Header="{loc:Tr DataImport_ResultId}" Binding="{Binding Id}" Width="220" />
                    <DataGridTextColumn Header="{loc:Tr DataImport_ResultError}" Binding="{Binding Error}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>

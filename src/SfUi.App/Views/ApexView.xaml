<UserControl x:Class="SfUi.App.Views.ApexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>

        <!-- ツールバー（幅が狭いときは折り返して全ボタンを表示） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Apex_Run}" Padding="10,2" Margin="0,2,12,2" Command="{Binding ExecuteCommand}" />
                <CheckBox Content="{loc:Tr Apex_AiAssist}" IsChecked="{Binding AiAssistEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2,12,2"
                          ToolTip="{loc:Tr Apex_AiAssistTip}" />
                <Button Content="{loc:Tr Apex_LoadFile}" Padding="10,2" Margin="0,2,6,2" Command="{Binding LoadFileCommand}" />
                <Button Content="{loc:Tr Apex_SaveFile}" Padding="10,2" Margin="0,2,12,2" Command="{Binding SaveFileCommand}" />
                <Border Width="1" Height="20" VerticalAlignment="Center" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="{loc:Tr Common_HistoryLabel}" VerticalAlignment="Center" Margin="0,2,4,2" />
                <ComboBox Width="240" VerticalAlignment="Center" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="{loc:Tr Apex_HistoryTip}" />
                <Button Content="⟳" Padding="8,2" Margin="0,2,12,2" Command="{Binding RefreshHistoryCommand}"
                        ToolTip="{loc:Tr Common_RefreshTip}" />
                <Border Width="1" Height="20" VerticalAlignment="Center" Background="#CCCCCC" Margin="0,2,12,2" />
                <Button Content="{loc:Tr Common_AddFavorite}" Padding="10,2" Margin="0,2,6,2" Command="{Binding AddFavoriteCommand}" />
                <Button Content="{loc:Tr Apex_FetchLatestLog}" Padding="10,2" Margin="0,2,0,2" Command="{Binding FetchLatestLogCommand}"
                        ToolTip="{loc:Tr Apex_FetchLatestLogTip}" />
            </WrapPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="170" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <avalonedit:TextEditor Grid.Row="0" x:Name="ApexEditor"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBlock Grid.Row="2" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="8,6" />

            <TextBox Grid.Row="3" Text="{Binding ResultLogs}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     ToolTip="{loc:Tr Apex_LogsTip}" />
        </Grid>
    </DockPanel>
</UserControl>

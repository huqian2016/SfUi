<UserControl x:Class="SfUi.App.Views.ApexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ 実行 (Ctrl+Enter)" Padding="10,2" Margin="0,0,12,0" Command="{Binding ExecuteCommand}" />
                <Button Content="読込…" Padding="10,2" Margin="0,0,6,0" Command="{Binding LoadFileCommand}" />
                <Button Content="保存…" Padding="10,2" Margin="0,0,12,0" Command="{Binding SaveFileCommand}" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="履歴:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="240" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="最近実行した匿名Apex を読み込み" />
                <Button Content="⟳" Padding="8,2" Margin="0,0,12,0" Command="{Binding RefreshHistoryCommand}"
                        ToolTip="履歴を再読込" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <Button Content="お気に入り追加" Padding="10,2" Margin="0,0,6,0" Command="{Binding AddFavoriteCommand}" />
                <Button Content="最新ログを表示" Padding="10,2" Command="{Binding FetchLatestLogCommand}"
                        ToolTip="org に保存されている最新のデバッグログを取得" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="170" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <avalonedit:TextEditor Grid.Row="0" x:Name="ApexEditor"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBlock Grid.Row="2" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="8,6" />

            <TextBox Grid.Row="3" Text="{Binding ResultLogs}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     ToolTip="デバッグログ（sf apex run の実行ログ / org から取得したログ）" />
        </Grid>
    </DockPanel>
</UserControl>

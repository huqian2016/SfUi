<Window x:Class="SfUi.App.Views.SchedulerJobEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:SfUi.App.Services"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Width="720" Height="700" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <svc:StringEqualsConverter x:Key="EnumEqualsConverter" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- フッター -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#B3261E" VerticalAlignment="Center"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="JobEditorValidation" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr Sched_EditorSave}" Click="OnSave"
                            Width="110" Padding="0,4" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="JobEditorSave" />
                    <Button Content="{loc:Tr Sched_EditorSaveAndRun}" Click="OnSaveAndRun"
                            Width="150" Padding="0,4" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="JobEditorSaveAndRun" />
                    <Button Content="{loc:Tr Common_Cancel}" IsCancel="True" Width="90" Padding="0,4" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本情報 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Tr Sched_EditorName}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="JobEditorName" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Tr Sched_EditorType}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding JobTypes}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                  SelectedValue="{Binding JobType}"
                                  AutomationProperties.AutomationId="JobEditorType" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Tr Sched_EditorOrg}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Orgs}" DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedOrg}"
                                  AutomationProperties.AutomationId="JobEditorOrg" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <CheckBox Content="{loc:Tr Sched_EnabledLabel}" IsChecked="{Binding IsEnabled}"
                                  VerticalAlignment="Bottom" Margin="0,20,0,4"
                                  AutomationProperties.AutomationId="JobEditorEnabled" />
                    </StackPanel>
                </Grid>

                <!-- 実行内容 -->
                <TextBlock Text="{loc:Tr Sched_EditorQuery}" Style="{StaticResource SectionHeader}"
                           Visibility="{Binding IsSoql, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding SoqlQuery, UpdateSourceTrigger=PropertyChanged}"
                         Height="150" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Visibility="{Binding IsSoql, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.AutomationId="JobEditorQuery" />
                <Grid Visibility="{Binding IsSoql, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr Sched_EditorCsvPath}" VerticalAlignment="Center"
                               Margin="0,8,8,0" Foreground="#555555" />
                    <TextBox Grid.Column="1" Text="{Binding CsvPath}" Margin="0,8,0,0" />
                </Grid>

                <TextBlock Text="{loc:Tr Sched_EditorSfArguments}" Style="{StaticResource SectionHeader}"
                           Visibility="{Binding IsSfCommand, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding SfArguments, UpdateSourceTrigger=PropertyChanged}"
                         Height="54" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas"
                         Visibility="{Binding IsSfCommand, Converter={StaticResource BoolToVis}}"
                         ToolTip="{loc:Tr Sched_EditorSfArgumentsTip}"
                         AutomationProperties.AutomationId="JobEditorSfArguments" />

                <!-- スケジュール -->
                <TextBlock Text="{loc:Tr Sched_EditorSchedule}" Style="{StaticResource SectionHeader}" />
                <WrapPanel>
                    <RadioButton Content="{loc:Tr Sched_KindOnce}" GroupName="ScheduleKind" Margin="0,0,16,0"
                                 IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=once}"
                                 AutomationProperties.AutomationId="JobEditorKindOnce" />
                    <RadioButton Content="{loc:Tr Sched_KindDaily}" GroupName="ScheduleKind" Margin="0,0,16,0"
                                 IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=daily}" />
                    <RadioButton Content="{loc:Tr Sched_KindWeekly}" GroupName="ScheduleKind" Margin="0,0,16,0"
                                 IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=weekly}" />
                    <RadioButton Content="{loc:Tr Sched_KindMonthly}" GroupName="ScheduleKind" Margin="0,0,16,0"
                                 IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=monthly}" />
                    <RadioButton Content="{loc:Tr Sched_KindInterval}" GroupName="ScheduleKind"
                                 IsChecked="{Binding ScheduleKind, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=interval}" />
                </WrapPanel>

                <!-- 1 回 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr Sched_OnceAt}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <DatePicker SelectedDate="{Binding OnceDate}" Width="140" Margin="0,0,12,0" />
                    <TextBlock Text="{loc:Tr Sched_TimeOfDay}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox Text="{Binding OnceTime}" Width="80" />
                </StackPanel>

                <!-- 毎日 / 毎週 / 毎月 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr Sched_TimeOfDay}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox Text="{Binding TimeOfDay}" Width="80" Margin="0,0,16,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Sched_MonthlyDays}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#555555" />
                        <TextBox Text="{Binding MonthlyDaysText}" Width="140"
                                 ToolTip="{loc:Tr Sched_MonthlyDaysTip}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsInterval, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Sched_IntervalMinutes}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                        <TextBox Text="{Binding IntervalMinutes}" Width="80" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,6,0,0"
                              Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,12,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="{loc:Tr Sched_EditorSkipWeekends}" IsChecked="{Binding SkipWeekends}"
                              Margin="0,0,16,0" />
                    <CheckBox Content="{loc:Tr Sched_EditorSkipHolidays}" IsChecked="{Binding SkipHolidays}" />
                </StackPanel>

                <!-- 通知 -->
                <TextBlock Text="{loc:Tr Sched_EditorNotification}" Style="{StaticResource SectionHeader}" />
                <CheckBox Content="{loc:Tr Sched_EditorNotifyEnabled}" IsChecked="{Binding NotifyEnabled}"
                          AutomationProperties.AutomationId="JobEditorNotifyEnabled" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding NotifyEnabled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr Sched_EditorPreNotice}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox Text="{Binding PreNoticeMinutes}" Width="60" />
                    <TextBlock Text="{loc:Tr Sched_MinutesUnit}" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <TextBox Text="{Binding PreNoticeSeconds}" Width="60" />
                    <TextBlock Text="{loc:Tr Sched_SecondsUnit}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <CheckBox Content="{loc:Tr Sched_EditorNotifyOnStart}" IsChecked="{Binding NotifyOnStart}"
                              Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="{loc:Tr Sched_EditorNotifyOnFinish}" IsChecked="{Binding NotifyOnFinish}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- 詳細 -->
                <TextBlock Text="{loc:Tr Sched_DetailTitle}" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Sched_EditorTimeout}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox Text="{Binding TimeoutMinutes}" Width="60" />
                    <TextBlock Text="{loc:Tr Sched_MinutesUnit}" VerticalAlignment="Center" Margin="4,0,20,0" />
                    <TextBlock Text="{loc:Tr Sched_EditorMissedGrace}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#555555" />
                    <TextBox Text="{Binding MissedGraceSeconds}" Width="60" />
                    <TextBlock Text="{loc:Tr Sched_SecondsUnit}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

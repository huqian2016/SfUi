<Window x:Class="SfUi.App.Views.ConnectedAppEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="760" Height="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding CancelText}" Width="110" Height="30" IsCancel="True" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="ConnEditorCancel" />
                    <Button Content="{Binding SaveText}" Width="120" Height="30" IsDefault="True" Click="Save_Click"
                            AutomationProperties.AutomationId="ConnEditorSave" />
                </StackPanel>
                <CheckBox Content="{Binding DryRunText}" IsChecked="{Binding DryRun}" VerticalAlignment="Center"
                          Margin="0,0,16,0" AutomationProperties.AutomationId="ConnEditorDryRun" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ConnEditorError" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
            <TextBlock Text="{Binding OrgDisplayName}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,8" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="12,4,12,8"
                    AutomationProperties.AutomationId="ConnEditorTabs">
            <TabItem Header="{Binding TabForm}" AutomationProperties.AutomationId="ConnEditorTabForm">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4,8,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LabelName}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNew}" Margin="0,0,0,12"
                                 AutomationProperties.AutomationId="ConnEditorName" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LabelDisplayName}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 AutomationProperties.AutomationId="ConnEditorLabel" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding LabelContactEmail}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 AutomationProperties.AutomationId="ConnEditorEmail" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding LabelDescription}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Height="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                                 AutomationProperties.AutomationId="ConnEditorDescription" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding LabelCallbackUrl}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
                            <TextBox Text="{Binding CallbackUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="64" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" AutomationProperties.AutomationId="ConnEditorCallback" />
                            <TextBlock Text="{Binding HintCallbackUrl}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding LabelScopes}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Scopes}" Margin="0,0,0,12"
                                      AutomationProperties.AutomationId="ConnEditorScopes">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,14,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding LabelIpRelaxation}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding IpRelaxations}" DisplayMemberPath="Label"
                                  SelectedValuePath="Key" SelectedValue="{Binding IpRelaxation, Mode=TwoWay}"
                                  Margin="0,0,0,12" AutomationProperties.AutomationId="ConnEditorIpRelaxation" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding LabelRefreshTokenPolicy}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding RefreshTokenPolicies}" DisplayMemberPath="Label"
                                  SelectedValuePath="Key" SelectedValue="{Binding RefreshTokenPolicy, Mode=TwoWay}"
                                  Margin="0,0,0,12" AutomationProperties.AutomationId="ConnEditorRefreshPolicy" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding LabelAdminApproved}" Style="{StaticResource FieldLabel}" Margin="0,0,10,12" />
                        <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding IsAdminApproved, Mode=TwoWay}"
                                  Content="{Binding LabelAdminApproved}" Margin="0,0,0,12"
                                  AutomationProperties.AutomationId="ConnEditorAdminApproved" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding LabelConsumerKey}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                        <StackPanel Grid.Row="9" Grid.Column="1">
                            <TextBox Text="{Binding ConsumerKey, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}"
                                     FontFamily="Consolas" AutomationProperties.AutomationId="ConnEditorConsumerKey" />
                            <TextBlock Text="{Binding HintConsumerKey}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding TabXml}" AutomationProperties.AutomationId="ConnEditorTabXml">
                <DockPanel Margin="4,8,4,4">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding HintXml}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Xml, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="ConnEditorXml" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="SfUi.App.Views.ConnectedAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        xmlns:services="clr-namespace:SfUi.App.Services"
        xmlns:views="clr-namespace:SfUi.App.Views"
        Title="{loc:Tr Conn_Title}"
        Height="720" Width="1120" MinHeight="480" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <services:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LabelOrg}" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Orgs}" SelectedItem="{Binding SelectedOrg}" DisplayMemberPath="DisplayName"
                          Width="240" VerticalAlignment="Center" Margin="0,0,12,0"
                          AutomationProperties.AutomationId="ConnOrg" />
                <TextBlock Text="{Binding LabelKind}" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label"
                          Width="190" VerticalAlignment="Center" Margin="0,0,12,0"
                          AutomationProperties.AutomationId="ConnKind" />
                <TextBlock Text="{Binding LabelSearch}" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center"
                         Margin="0,0,12,0" AutomationProperties.AutomationId="ConnSearch" />
                <Button Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ConnRefresh" />
                <Button Content="{Binding NewText}" Command="{Binding NewCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ConnNew" />
                <Button Content="{Binding EditText}" Command="{Binding EditCommand}" Style="{StaticResource ToolButton}"
                        IsEnabled="{Binding HasDocument}" AutomationProperties.AutomationId="ConnEdit" />
                <Button Content="{Binding DeleteText}" Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}"
                        IsEnabled="{Binding HasSelection}" AutomationProperties.AutomationId="ConnDelete" />
                <Button Content="{Binding OpenSetupText}" Command="{Binding OpenSetupCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ConnOpenSetup" />
            </WrapPanel>
        </Border>

        <!-- ステータス バー -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ConnStatus" />
                <TextBlock Text="{Binding CreationRestrictedHint}" Foreground="#B35C00" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsCreationRestricted, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="ConnRestrictedHint" />
                <TextBlock Text="{Binding EcaRecommendHint}" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsConnectedAppKind, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="ConnEcaHint" />
            </StackPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyHint}" Foreground="#777777" TextWrapping="Wrap"
                           Margin="0,0,0,6" AutomationProperties.AutomationId="ConnEmpty"
                           Visibility="{Binding HasApps, Converter={StaticResource InverseBoolToVis}}" />
                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                         AutomationProperties.AutomationId="ConnApps">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ScopesText}" Foreground="#777777" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding DetailEmpty}" Foreground="#777777" Margin="8,4"
                               Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}"
                               AutomationProperties.AutomationId="ConnDetailEmpty" />

                    <StackPanel DataContext="{Binding Document}" Margin="8,0"
                                Visibility="{Binding DataContext.HasDocument, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DataContext.DetailTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DataContext.LabelName, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Name}" AutomationProperties.AutomationId="ConnDetailName" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DataContext.LabelDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Label}" Margin="0,0,0,10" AutomationProperties.AutomationId="ConnDetailLabel" />

                        <TextBlock Text="{Binding DataContext.LabelContactEmail, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ContactEmail}" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DataContext.LabelDescription, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DataContext.LabelCallbackUrlText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding CallbackUrlText}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,10"
                                   AutomationProperties.AutomationId="ConnDetailCallback" />

                        <TextBlock Text="{Binding DataContext.LabelScopesText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ScopesText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   AutomationProperties.AutomationId="ConnDetailScopes" />

                        <TextBlock Text="{Binding DataContext.LabelConsumerKeyText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ConsumerKey}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,10" />

                        <StackPanel Visibility="{Binding HasConsumerKey, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding DataContext.HintConsumerKey, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,10" />
                        </StackPanel>

                        <TextBlock Text="{Binding DataContext.LabelIpRelaxationText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding IpRelaxation}" Margin="0,0,0,10" />

                        <TextBlock Text="{Binding DataContext.LabelRefreshTokenPolicyText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding RefreshTokenPolicy}" Margin="0,0,0,10" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

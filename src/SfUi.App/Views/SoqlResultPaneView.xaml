<UserControl x:Class="SfUi.App.Views.SoqlResultPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- 複数 SOQL 実行時の結果枠 1 つ（見出し + 絞り込み + 読み取り専用グリッド） -->
    <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Background="White">
        <DockPanel>

            <!-- 見出し（何文目か + SOQL / 表示行数 / キャッシュ状態） -->
            <Border DockPanel.Dock="Top" Background="#F3F6FA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFF3CD" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="9"
                                Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding IsCachedResult, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CachedResultText}" Foreground="#8A6100" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding CountText}" Foreground="#666666" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="SoqlPaneCount" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Query}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="SoqlPaneTitle" />
                </DockPanel>
            </Border>

            <!-- 絞り込み + 状態 -->
            <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding FilterLabel}" Foreground="#555555"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="#666666"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="SoqlPaneStatus" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="4,2"
                             AutomationProperties.AutomationId="SoqlPaneFilter"
                             AutomationProperties.Name="{Binding FilterLabel}" />
                </DockPanel>
            </Border>

            <!-- エラー（この文だけ失敗した場合） -->
            <Border DockPanel.Dock="Top" Background="#FDECEA" Padding="8,4"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorText}" Foreground="#B00020" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SoqlPaneError" />
            </Border>

            <DataGrid x:Name="PaneGrid" Height="240" ItemsSource="{Binding VisibleRows}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionUnit="CellOrRowHeader" RowHeaderWidth="0"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      AlternatingRowBackground="#F7F9FB"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      AutomationProperties.AutomationId="SoqlPaneGrid"
                      AutomationProperties.Name="{Binding Title}" />
        </DockPanel>
    </Border>
</UserControl>

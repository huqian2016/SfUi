<UserControl x:Class="SfUi.App.Views.OrgInfoCustomTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ツールバー: 参照元の再取得 + 項目編集 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="{loc:Tr OrgInfo_RefreshSection}" Padding="10,2" Margin="0,0,12,0"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"
                        ToolTip="{loc:Tr OrgInfo_Custom_RefreshTip}" />
                <Button x:Name="EditButton" Content="{loc:Tr OrgInfo_Custom_Edit}" Padding="10,2" Margin="0,0,12,0"
                        Command="{Binding EditCommand}" ToolTip="{loc:Tr OrgInfo_Custom_EditTip}" />
                <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Foreground="#666666" />
                <TextBlock Text="{loc:Tr OrgInfo_Loading}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- ステータス: 取得時刻 + エラー -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FetchedAtText}" Foreground="#555555" />
                <TextBlock Text="{Binding ErrorText}" Foreground="#B00020" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                      AlternatingRowBackground="#F7F9FB"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr OrgInfo_Col_Item}" Binding="{Binding Label}" Width="220" />
                    <DataGridTextColumn Header="{loc:Tr OrgInfo_Col_Value}" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="{loc:Tr OrgInfo_Col_Source}" Binding="{Binding SourceName}" Width="150" />
                    <DataGridTextColumn Header="{loc:Tr OrgInfo_Col_FetchedAt}" Binding="{Binding FetchedAtText}" Width="180" />
                    <DataGridTemplateColumn Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="↗" Padding="6,0" FontSize="11" IsEnabled="{Binding HasLink}"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyMessage}" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

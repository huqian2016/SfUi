<UserControl x:Class="SfUi.App.Views.OrgInfoSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ツールバー: このタブを再取得 + タブ内検索 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="{loc:Tr OrgInfo_RefreshSection}" Padding="10,2" Margin="0,0,12,0"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}"
                        ToolTip="{loc:Tr OrgInfo_RefreshSectionTip}" />
                <Button Content="{loc:Tr OrgInfo_OpenSetup}" Padding="10,2" Margin="0,0,12,0"
                        Command="{Binding OpenSetupCommand}"
                        Visibility="{Binding HasSetupLink, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Tr OrgInfo_OpenSetupTip}" />
                <Button Content="{loc:Tr Main_DataIo}" Padding="10,2" Margin="0,0,12,0"
                        Command="{Binding OpenDataIoCommand}"
                        Visibility="{Binding IsObjectsSection, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:Tr Main_DataIoTip}" />
                <TextBlock Text="{loc:Tr OrgInfo_SearchLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="280" VerticalContentAlignment="Center"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr OrgInfo_SearchTip}" />
                <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666" />
                <TextBlock Text="{loc:Tr OrgInfo_Loading}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- ステータス: 取得時刻 + エラー -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FetchedAtText}" Foreground="#555555" />
                <TextBlock x:Name="ErrorTextBlock" Text="{Binding ErrorText}" Foreground="#B00020" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="All"
                      AlternatingRowBackground="#F7F9FB"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" />
            <TextBlock Text="{Binding EmptyMessage}" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EmptyMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

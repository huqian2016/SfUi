<UserControl x:Class="SfUi.App.Views.ApiConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Workbench REST Explorer 風のメソッド ボタン -->
        <Style x:Key="ApiMethodButton" TargetType="Button">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="Margin" Value="0,2,4,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- リクエスト バー（Workbench の REST Explorer 風） -->
        <Border DockPanel.Dock="Top" Background="#F5F5F5" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="☰" Padding="8,2" Margin="0,2,8,2" Command="{Binding ToggleTreeCommand}"
                            ToolTip="{loc:Tr ApiTree_ToggleTip}"
                            AutomationProperties.AutomationId="ApiTreeToggle" />

                    <Button Content="GET"
                            Command="{Binding SetMethodCommand}" CommandParameter="GET"
                            AutomationProperties.AutomationId="ApiMethodGet">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApiMethodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGetMethod}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Background" Value="#2E7D32" />
                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="POST"
                            Command="{Binding SetMethodCommand}" CommandParameter="POST"
                            AutomationProperties.AutomationId="ApiMethodPost">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApiMethodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPostMethod}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Background" Value="#1565C0" />
                                        <Setter Property="BorderBrush" Value="#1565C0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="PATCH"
                            Command="{Binding SetMethodCommand}" CommandParameter="PATCH"
                            AutomationProperties.AutomationId="ApiMethodPatch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApiMethodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPatchMethod}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Background" Value="#B26A00" />
                                        <Setter Property="BorderBrush" Value="#B26A00" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="DELETE"
                            Command="{Binding SetMethodCommand}" CommandParameter="DELETE"
                            AutomationProperties.AutomationId="ApiMethodDelete">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApiMethodButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleteMethod}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="Background" Value="#C62828" />
                                        <Setter Property="BorderBrush" Value="#C62828" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{loc:Tr Common_AddFavorite}" Padding="10,2" Margin="0,2,6,2" Command="{Binding AddFavoriteCommand}" />
                    <Button Content="{loc:Tr Report_Export}" Padding="10,2" Margin="0,2,0,2" Command="{Binding ExportReportCommand}"
                            AutomationProperties.AutomationId="ApiExportReport" />
                    <Button Content="⟳" Padding="8,2" Margin="6,2,0,2" Command="{Binding ReloadTreeCommand}"
                            ToolTip="{loc:Tr ApiTree_Refresh}"
                            AutomationProperties.AutomationId="ApiTreeReload" />
                </WrapPanel>

                <!-- パス + 実行（Workbench の URL 欄 + EXECUTE） -->
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="{loc:Tr Api_Execute}" MinWidth="96" Padding="12,3"
                            Margin="6,0,0,0" FontWeight="SemiBold" Command="{Binding SendCommand}"
                            AutomationProperties.AutomationId="ApiSend" />
                    <TextBox VerticalContentAlignment="Center" FontFamily="Consolas" Height="26"
                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:Tr Api_PathTip}"
                             AutomationProperties.AutomationId="ApiPath" />
                </DockPanel>

                <!-- 絶対 URL（Workbench の Absolute URL） -->
                <TextBlock Text="{Binding AbsoluteUrl}" Margin="0,3,0,0" FontSize="11" Foreground="#777777"
                           TextTrimming="CharacterEllipsis" ToolTip="{loc:Tr Api_UrlTip}"
                           AutomationProperties.AutomationId="ApiAbsoluteUrl" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" AutomationProperties.AutomationId="ApiStatus" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- エンドポイント ツリー -->
            <DockPanel Grid.Column="0" Width="310"
                       Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" Background="#F7F7F7" Padding="6,4" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding TreeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Tr ApiTree_SearchPlaceholder}"
                                 AutomationProperties.AutomationId="ApiTreeFilter" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TreeView ItemsSource="{Binding TreeNodes}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              BorderThickness="0" Padding="2"
                              AutomationProperties.AutomationId="ApiTree">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Method}" FontSize="10" FontWeight="Bold" Width="48"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#666666" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Method}" Value="GET">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="POST">
                                                        <Setter Property="Foreground" Value="#1565C0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="PATCH">
                                                        <Setter Property="Foreground" Value="#B26A00" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Method}" Value="DELETE">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                                 Visibility="{Binding IsTreeLoading, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.AutomationId="ApiTreeLoading" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD"
                          Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 選択したエンドポイントのパラメータ -->
                <ItemsControl Grid.Row="0" Margin="8,8,8,0" ItemsSource="{Binding Parameters}"
                              Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}"
                              AutomationProperties.AutomationId="ApiParams">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="260" FontFamily="Consolas" FontSize="12"
                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="{Binding AutomationId}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- リクエスト本文（GET / DELETE では隠す） -->
                <DockPanel Grid.Row="1" Margin="8,6,8,0"
                           Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Api_BodyLabel}" Margin="0,0,0,4" Foreground="#666666" />
                    <TextBox Height="110" FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             Text="{Binding RequestBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="ApiBody" />
                </DockPanel>

                <!-- 応答ヘッダー（Workbench の Show Raw Response） -->
                <DockPanel Grid.Row="2" Margin="8,8,8,0">
                    <CheckBox DockPanel.Dock="Right" Content="{loc:Tr Api_RawResponse}" VerticalAlignment="Center"
                              IsChecked="{Binding IsRawResponse, Mode=TwoWay}"
                              AutomationProperties.AutomationId="ApiRawResponse" />
                    <TextBlock Text="{loc:Tr Api_ResponseLabel}" Foreground="#666666" VerticalAlignment="Center" />
                </DockPanel>

                <TextBox Grid.Row="3" Margin="8,4,8,8" Text="{Binding DisplayResponse, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         ToolTip="{loc:Tr Api_ResponseTip}"
                         AutomationProperties.AutomationId="ApiResponse" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

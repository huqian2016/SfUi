<UserControl x:Class="SfUi.App.Views.ApiConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="90" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method, Mode=TwoWay}" />
                <TextBox Width="400" Margin="6,0,6,0" VerticalContentAlignment="Center" FontFamily="Consolas"
                         Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="instanceUrl からのパス（例: /services/data/v67.0/limits / /services/data/v67.0/sobjects）" />
                <Button Content="送信" Padding="10,2" Margin="0,0,12,0" Command="{Binding SendCommand}" />
                <TextBlock Text="履歴:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="220" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="最近送信したリクエストを読み込み" />
                <Button Content="⟳" Padding="8,2" Margin="0,0,12,0" Command="{Binding RefreshHistoryCommand}" />
                <Button Content="お気に入り追加" Padding="10,2" Command="{Binding AddFavoriteCommand}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,8,8,0">
                <TextBlock DockPanel.Dock="Top" Text="リクエスト ボディ（JSON・POST/PATCH で使用）" Margin="0,0,0,4" Foreground="#666666" />
                <TextBox Height="110" FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         Text="{Binding RequestBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBox Grid.Row="2" Margin="8,4,8,8" Text="{Binding ResponseText}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     ToolTip="レスポンス（JSON は整形して表示）" />
        </Grid>
    </DockPanel>
</UserControl>

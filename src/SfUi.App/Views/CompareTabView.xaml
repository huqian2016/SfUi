<UserControl x:Class="SfUi.App.Views.CompareTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="620" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左: 基準 (A) と 比較対象 (B) の選択 -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr BackupCompare_BaseLabelA}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                         Text="{Binding SearchTextA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr Restore_BackupSearch}"
                         AutomationProperties.Name="{loc:Tr Restore_BackupSearch}" />
                <ListBox ItemsSource="{Binding BackupsViewA}" BorderBrush="#DDDDDD"
                         SelectedItem="{Binding SelectedBackupA, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#666666" FontSize="11" />
                                <TextBlock Text="{Binding Summary}" Foreground="#666666" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Tr BackupCompare_BaseLabelB}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                         Text="{Binding SearchTextB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr Restore_BackupSearch}"
                         AutomationProperties.Name="{loc:Tr Restore_BackupSearch}" />
                <ListBox ItemsSource="{Binding BackupsViewB}" BorderBrush="#DDDDDD"
                         SelectedItem="{Binding SelectedBackupB, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="#666666" FontSize="11" />
                                <TextBlock Text="{Binding Summary}" Foreground="#666666" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- 右: 比較結果（差分はハイライト） -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button Content="{loc:Tr BackupCompare_Compare}" Padding="14,4"
                        Command="{Binding CompareCommand}"
                        AutomationProperties.Name="{loc:Tr BackupCompare_Compare}" />
                <Button Content="{loc:Tr BackupCompare_Cancel}" Margin="8,0,0,0" Padding="14,4"
                        Command="{Binding CancelCompareCommand}"
                        AutomationProperties.Name="{loc:Tr BackupCompare_Cancel}" />
                <CheckBox Content="{loc:Tr BackupCompare_DiffOnly}" Margin="14,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding DiffOnly, Mode=TwoWay}" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#555555" TextTrimming="CharacterEllipsis" MaxWidth="380" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap" />
            <DataGrid x:Name="CompareGrid" Grid.Row="2" ItemsSource="{Binding ResultsView}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="28" EnableRowVirtualization="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                <Setter Property="Background" Value="#FFF3CD" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Background" Value="#FDECEA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OnlyInA}" Value="True">
                                <Setter Property="Background" Value="#E8EAF6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OnlyInB}" Value="True">
                                <Setter Property="Background" Value="#F3E5F5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Backup_ColObject}" Width="180" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="{loc:Tr Backup_ColLabel}" Width="*" MinWidth="140" Binding="{Binding Label}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColCountA}" Width="80" Binding="{Binding CountAText}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColCountB}" Width="80" Binding="{Binding CountBText}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColAdded}" Width="70" Binding="{Binding AddedText}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColRemoved}" Width="70" Binding="{Binding RemovedText}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColChanged}" Width="70" Binding="{Binding ChangedText}" />
                    <DataGridTextColumn Header="{loc:Tr BackupCompare_ColStatus}" Width="90" Binding="{Binding StatusText}" />
                    <DataGridTemplateColumn Header="{loc:Tr Restore_Details}" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="↗" Padding="6,0" Margin="2,0" FontSize="11"
                                        ToolTip="{loc:Tr BackupCompare_DetailsTip}"
                                        AutomationProperties.Name="{loc:Tr BackupCompare_DetailsTip}"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

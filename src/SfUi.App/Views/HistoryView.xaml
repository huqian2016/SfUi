<UserControl x:Class="SfUi.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App"
             x:Name="Root">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr History_TypeLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="120" Margin="0,0,12,0"
                          ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label" />

                <TextBlock Text="{loc:Tr History_SearchLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="260" Margin="0,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr History_SearchTip}" />

                <Button Content="{loc:Tr History_Refresh}" Padding="10,2" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                <Button Content="{loc:Tr History_CopyParams}" Padding="10,2" Margin="0,0,6,0" Command="{Binding CopyParamsCommand}"
                        ToolTip="{loc:Tr History_CopyParamsTip}" />
                <Button Content="{loc:Tr History_DeleteSelected}" Padding="10,2" Margin="0,0,6,0" Command="{Binding DeleteSelectedCommand}" />
                <Button Content="{loc:Tr History_ClearAll}" Padding="10,2" Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F9FB">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr History_ColTime}" Binding="{Binding TimestampLocal}" Width="140" />
                    <DataGridTextColumn Header="{loc:Tr History_ColType}" Binding="{Binding TypeLabel}" Width="80" />
                    <DataGridTextColumn Header="{loc:Tr History_ColOrg}" Binding="{Binding Org}" Width="110" />
                    <DataGridTextColumn Header="{loc:Tr History_ColFolder}" Binding="{Binding Folder}" Width="200" />
                    <DataGridTextColumn Header="{loc:Tr History_ColSummary}" Binding="{Binding Summary}" Width="*" />
                    <DataGridTextColumn Header="{loc:Tr History_ColStatus}" Binding="{Binding StatusLabel}" Width="60" />
                    <DataGridTextColumn Header="{loc:Tr History_ColDuration}" Binding="{Binding DurationMs}" Width="70" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Tr History_CopyParams}"
                                  Command="{Binding DataContext.CopyParamsCommand, ElementName=Root}" />
                        <MenuItem Header="{loc:Tr History_DeleteSelected}"
                                  Command="{Binding DataContext.DeleteSelectedCommand, ElementName=Root}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <TextBlock Text="{loc:Tr History_Empty}"
                       Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="SfUi.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="種別:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="120" Margin="0,0,12,0"
                          ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding TypeFilter, Mode=TwoWay}" />

                <TextBlock Text="検索:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="260" Margin="0,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="概要 / パラメータ / 組織 / フォルダを検索" />

                <Button Content="⟳ 更新" Padding="10,2" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                <Button Content="パラメータをコピー" Padding="10,2" Margin="0,0,6,0" Command="{Binding CopyParamsCommand}"
                        ToolTip="選択した履歴の SOQL / Apex / コマンド内容をコピー" />
                <Button Content="選択を削除" Padding="10,2" Margin="0,0,6,0" Command="{Binding DeleteSelectedCommand}" />
                <Button Content="すべて削除" Padding="10,2" Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Border>

        <Grid>
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F9FB">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日時" Binding="{Binding TimestampLocal}" Width="140" />
                    <DataGridTextColumn Header="種別" Binding="{Binding TypeLabel}" Width="80" />
                    <DataGridTextColumn Header="組織" Binding="{Binding Org}" Width="110" />
                    <DataGridTextColumn Header="フォルダ" Binding="{Binding Folder}" Width="200" />
                    <DataGridTextColumn Header="概要" Binding="{Binding Summary}" Width="*" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StatusLabel}" Width="60" />
                    <DataGridTextColumn Header="所要(ms)" Binding="{Binding DurationMs}" Width="70" />
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="パラメータをコピー"
                                  Command="{Binding DataContext.CopyParamsCommand, ElementName=Root}" />
                        <MenuItem Header="選択を削除"
                                  Command="{Binding DataContext.DeleteSelectedCommand, ElementName=Root}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <TextBlock Text="まだ履歴がありません。SOQL / 匿名Apex / コマンドの実行が自動記録されます。"
                       Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="SfUi.App.Views.OrgInfoFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SfUi.App.Views"
             xmlns:vm="clr-namespace:SfUi.App.ViewModels;assembly=SfUi.Presentation"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:OrgInfoSectionViewModel}">
            <views:OrgInfoSectionView />
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>

        <!-- ツールバー: オブジェクト選択（選択時に遅延取得） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr OrgInfo_Fields_SelectObject}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FieldObjectComboBox" Width="340" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display"
                          ItemsSource="{Binding Objects}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedObject, Mode=TwoWay}" />
                <TextBlock Text="{Binding Hint}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Grid>
            <ContentControl Content="{Binding Section}" />
            <TextBlock Text="{loc:Tr OrgInfo_Fields_NoSelection}" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Section}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>

<Window x:Class="SfUi.App.Views.SourceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        xmlns:vm="clr-namespace:SfUi.App.ViewModels;assembly=SfUi.Presentation"
        xmlns:core="clr-namespace:SfUi.Core;assembly=SfUi.Core"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="820" Width="1280" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock x:Name="SourceEditorStatusText" Text="{Binding StatusMessage}" Foreground="#666666" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OrgLabel}" FontWeight="SemiBold" VerticalAlignment="Center"
                           AutomationProperties.Name="Org" />
                <Button x:Name="SourceEditorReloadButton" Content="{loc:Tr SourceEditor_Refresh}" Padding="12,3" Margin="16,0,0,0"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="{loc:Tr SourceEditor_Refresh}" />
                <TextBlock Text="{loc:Tr SourceEditor_FilterTip}" Margin="16,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="SourceEditorFilterBox" Width="220" VerticalContentAlignment="Center"
                         ToolTip="{loc:Tr SourceEditor_FilterTip}"
                         Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:Tr SourceEditor_FilterTip}" />
                <TextBlock Text="{Binding CaretText}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666666" />
            </StackPanel>
        </Border>

        <!-- メタデータ エクスプローラー + エディタ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="SourceEditorTree" ItemsSource="{Binding Groups}"
                      SelectedItemChanged="SourceEditorTree_SelectedItemChanged"
                      AutomationProperties.Name="{loc:Tr SourceEditor_Title}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:SourceMemberGroupViewModel}" ItemsSource="{Binding Members}">
                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" Padding="0,2" />
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type core:SourceMemberInfo}">
                        <TextBlock Text="{Binding Name}" Padding="0,1" />
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#EEEEEE" />

            <TabControl x:Name="SourceEditorTabs" Grid.Column="2" Margin="6,0,0,0"
                        ItemsSource="{Binding OpenFiles}"
                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                            <Button Content="×" Margin="6,0,0,0" Padding="3,0" FontSize="11" VerticalAlignment="Center"
                                    Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{loc:Tr SourceEditor_CloseTip}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <avalonedit:TextEditor IsReadOnly="True"
                                               ShowLineNumbers="True"
                                               FontFamily="Consolas" FontSize="13"
                                               HorizontalScrollBarVisibility="Auto"
                                               VerticalScrollBarVisibility="Auto"
                                               Loaded="Editor_Loaded"
                                               Unloaded="Editor_Unloaded" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>

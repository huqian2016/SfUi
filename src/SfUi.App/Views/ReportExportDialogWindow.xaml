<Window x:Class="SfUi.App.Views.ReportExportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F7F7">
    <StackPanel Margin="16">

        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!-- 内容 -->
        <TextBlock Text="{Binding ContentsLabel}" Foreground="#666666" Margin="0,0,0,4" />
        <Border Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}" AutomationProperties.AutomationId="ReportSections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 出力形式 -->
        <TextBlock Text="{Binding FormatsLabel}" Foreground="#666666" Margin="0,14,0,4" />
        <UniformGrid Columns="2">
            <CheckBox Content="{Binding FormatCsv}" IsChecked="{Binding Csv}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatCsv" />
            <CheckBox Content="{Binding FormatMarkdown}" IsChecked="{Binding Markdown}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatMarkdown" />
            <CheckBox Content="{Binding FormatHtml}" IsChecked="{Binding Html}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatHtml" />
            <CheckBox Content="{Binding FormatExcel}" IsChecked="{Binding Excel}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatExcel" />
            <CheckBox Content="{Binding FormatPdf}" IsChecked="{Binding Pdf}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatPdf" />
            <CheckBox Content="{Binding FormatTsv}" IsChecked="{Binding Tsv}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatTsv" />
            <CheckBox Content="{Binding FormatJson}" IsChecked="{Binding Json}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatJson" />
            <CheckBox Content="{Binding FormatJsonLines}" IsChecked="{Binding JsonLines}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatJsonLines" />
            <CheckBox Content="{Binding FormatXml}" IsChecked="{Binding Xml}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatXml" />
            <CheckBox Content="{Binding FormatYaml}" IsChecked="{Binding Yaml}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatYaml" />
            <CheckBox Content="{Binding FormatPng}" IsChecked="{Binding Png}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatPng" />
            <CheckBox Content="{Binding FormatJpeg}" IsChecked="{Binding Jpeg}" Margin="0,2" AutomationProperties.AutomationId="ReportFormatJpeg" />
        </UniformGrid>

        <CheckBox Content="{Binding IncludeAnalysisLabel}" IsChecked="{Binding IncludeAnalysis}" Margin="0,10,0,0"
                  AutomationProperties.AutomationId="ReportIncludeAnalysis" />

        <!-- 行数 / ファイル名 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MaxRowsLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxRowsText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ReportMaxRows" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FileNameLabel}" VerticalAlignment="Center" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0"
                     Text="{Binding BaseName, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ReportBaseName" />
        </Grid>

        <!-- 出力先 -->
        <TextBlock Text="{Binding OutputFolderLabel}" Foreground="#666666" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding BrowseLabel}" Padding="12,3" Margin="6,0,0,0"
                    Command="{Binding BrowseCommand}" AutomationProperties.AutomationId="ReportBrowse" />
            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ReportOutputFolder" />
        </DockPanel>

        <CheckBox Content="{Binding OpenAfterSaveLabel}" IsChecked="{Binding OpenAfterSave}" Margin="0,10,0,0"
                  AutomationProperties.AutomationId="ReportOpenAfter" />

        <TextBlock Text="{Binding ErrorText}" Foreground="#C62828" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="ReportError" />

        <!-- ボタン -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding ExportLabel}" IsDefault="True" MinWidth="110" Padding="12,4" Click="Export_Click"
                    AutomationProperties.AutomationId="ReportExportOk" />
            <Button Content="{Binding CancelLabel}" IsCancel="True" MinWidth="90" Padding="12,4" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ReportExportCancel" />
        </StackPanel>
    </StackPanel>
</Window>

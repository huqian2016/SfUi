<UserControl x:Class="SfUi.App.Views.QuickPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="クイックパネル（Ctrl+1..9）" FontWeight="Bold" Margin="8,8,8,4"
                   ToolTip="お気に入りを登録した順に表示。Ctrl+数字で即実行できます" />

        <TextBlock DockPanel.Dock="Bottom" Text="ダブルクリック / Ctrl+数字 で実行、右クリックで削除" FontSize="10"
                   Foreground="Gray" Margin="8,4,8,8" TextWrapping="Wrap" />

        <ListBox x:Name="FavoritesList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 MouseDoubleClick="OnItemDoubleClick"
                 PreviewKeyDown="OnListPreviewKeyDown"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding ToolTipText}" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#007ACC"
                                VerticalAlignment="Top" Margin="0,2,6,0">
                            <TextBlock Text="{Binding SlotText}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#007ACC" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="実行" Click="OnExecuteClick" />
                    <MenuItem Header="お気に入りから削除" Click="OnRemoveClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>

<UserControl x:Class="SfUi.App.Views.CompareRecordsCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SfUi.App.Views"
             xmlns:loc="clr-namespace:SfUi.App">
    <DockPanel>

        <!-- ツールバー: オブジェクト / 照合キー / 上限 / 比較実行 / 比較項目（複数選択） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{loc:Tr Compare_FieldsObjectLabel}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <ComboBox x:Name="RecordsObjectComboBox" Width="260" VerticalAlignment="Top" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display" MaxDropDownHeight="320"
                          ItemsSource="{Binding Objects}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" />
                <TextBlock Text="{loc:Tr Compare_KeyFieldLabel}" VerticalAlignment="Top" Margin="12,6,4,0" />
                <ComboBox Width="190" VerticalAlignment="Top" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display" MaxDropDownHeight="320"
                          ItemsSource="{Binding KeyFields}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedKeyField, Mode=TwoWay}" />
                <TextBlock Text="{loc:Tr Compare_LimitLabel}" VerticalAlignment="Top" Margin="12,6,4,0" />
                <TextBox Width="64" VerticalAlignment="Top" VerticalContentAlignment="Center"
                         Text="{Binding LimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="{loc:Tr Compare_RunButton}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"
                        Command="{Binding RunCommand}" Click="OnRunClick" />
                <Expander x:Name="FieldsExpander" Header="{loc:Tr Compare_CompareFieldsLabel}" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Width="280" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Fields}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <views:CompareCategoryView />
    </DockPanel>
</UserControl>

<UserControl x:Class="SfUi.App.Views.SoqlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ 実行 (Ctrl+Enter)" Padding="10,2" Margin="0,0,12,0" Command="{Binding ExecuteCommand}" />
                <CheckBox Content="REST優先" IsChecked="{Binding PreferRest}" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="REST API（アクセストークン）で実行し、失敗時は sf data query にフォールバック" />
                <CheckBox Content="Tooling API" IsChecked="{Binding UseToolingApi}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="履歴:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="260" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="最近実行した SOQL を読み込み" />
                <Button Content="⟳" Padding="8,2" Margin="0,0,12,0" Command="{Binding RefreshHistoryCommand}"
                        ToolTip="履歴を再読込" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <Button Content="お気に入り追加" Padding="10,2" Margin="0,0,6,0" Command="{Binding AddFavoriteCommand}" />
                <Button Content="CSV出力" Padding="10,2" Margin="0,0,6,0" Command="{Binding ExportCsvCommand}" />
                <Button Content="結果をコピー" Padding="10,2" Command="{Binding CopyResultsCommand}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <avalonedit:TextEditor Grid.Row="0" x:Name="SoqlEditor"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <DataGrid Grid.Row="2" ItemsSource="{Binding ResultView}"
                      AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                      SelectionUnit="CellOrRowHeader" RowHeaderWidth="0"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      AlternatingRowBackground="#F7F9FB"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True" />
        </Grid>
    </DockPanel>
</UserControl>

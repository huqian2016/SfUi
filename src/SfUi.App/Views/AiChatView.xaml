<UserControl x:Class="SfUi.App.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ツールバー（コンテキスト選択と操作） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Ai_Clear}" Padding="10,2" Margin="0,0,12,0" Command="{Binding ClearChatCommand}" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="{loc:Tr Ai_ContextLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="320" ItemsSource="{Binding ContextEntries}" SelectedItem="{Binding SelectedContextEntry, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="{loc:Tr Ai_ContextTip}" />
                <CheckBox Content="{loc:Tr Ai_AttachContext}" IsChecked="{Binding AttachContext, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="8,0,12,0" />
                <Button Content="{loc:Tr Ai_AnalyzeLast}" Padding="10,2" Margin="0,0,6,0" Command="{Binding AnalyzeLastCommand}" />
                <Button Content="⟳" Padding="8,2" Command="{Binding RefreshContextCommand}" ToolTip="{loc:Tr Common_RefreshTip}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <!-- 入力 -->
        <Grid DockPanel.Dock="Bottom" Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="InputBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="6,4"
                     Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Tr Ai_InputTip}" />
            <Button Grid.Column="1" Content="{loc:Tr Ai_Send}" Width="120" Margin="6,0,0,0" VerticalAlignment="Stretch"
                    Command="{Binding SendCommand}" />
            <Button Grid.Column="2" Content="{loc:Tr Common_Cancel}" Width="90" Margin="6,0,0,0" VerticalAlignment="Stretch"
                    Command="{Binding CancelCommand}" />
        </Grid>

        <!-- 会話 -->
        <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Padding="4">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8,4" Padding="10,6" CornerRadius="6" MaxWidth="900" HorizontalAlignment="Left"
                                BorderBrush="#DDDDDD" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="Background" Value="#E7F1FF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" FontSize="11" Foreground="#007ACC" />
                                <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" MaxWidth="860"
                                         VerticalScrollBarVisibility="Disabled" />
                                <ItemsControl ItemsSource="{Binding Snippets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ApplyLabel}" Padding="10,2" Margin="0,6,8,0"
                                                    Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ApplySnippetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

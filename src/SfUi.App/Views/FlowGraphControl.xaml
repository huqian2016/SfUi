<UserControl x:Class="SfUi.App.Views.FlowGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App"
             xmlns:views="clr-namespace:SfUi.App.Views">
    <UserControl.Resources>
        <views:HexBrushConverter x:Key="HexBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>

        <!-- ヘッダー（タイトル / ズーム / 閉じる） -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Button x:Name="FlowCloseButton" DockPanel.Dock="Right" Content="{loc:Tr SourceEditor_FlowClose}"
                        Padding="10,3" Margin="8,0,0,0" Click="Close_Click"
                        AutomationProperties.Name="{loc:Tr SourceEditor_FlowClose}" />
                <TextBlock x:Name="FlowGraphStatusText" DockPanel.Dock="Right" Text="{Binding CountText}"
                           Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666666" />
                <TextBlock DockPanel.Dock="Right" Text="Zoom" Margin="16,0,6,0" VerticalAlignment="Center" Foreground="#666666" />
                <Slider x:Name="FlowZoomSlider" DockPanel.Dock="Right" Width="130" Minimum="0.5" Maximum="1.5"
                        VerticalAlignment="Center" Value="{Binding Zoom}" />
                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ノード詳細 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="FlowDetailsHeader" Text="{Binding SelectedNodeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl x:Name="FlowDetailsList" ItemsSource="{Binding SelectedNodeDetails}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Label}" Width="150" Foreground="#666666" />
                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- グラフ キャンバス -->
        <ScrollViewer x:Name="FlowGraphScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
            <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Margin="10"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Grid.LayoutTransform>

                <!-- エッジ -->
                <ItemsControl ItemsSource="{Binding Edges}" AutomationProperties.Name="Edges">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="{Binding StrokeHex, Converter={StaticResource HexBrush}}" StrokeThickness="1.6" />
                                <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Background="#F0F0F0"
                                        CornerRadius="3" Padding="3,1"
                                        Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#555555" />
                                </Border>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ノード -->
                <ItemsControl ItemsSource="{Binding Nodes}" AutomationProperties.Name="Nodes">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}" Height="{Binding Height}" CornerRadius="6" BorderThickness="2"
                                    Background="{Binding BackgroundHex, Converter={StaticResource HexBrush}}"
                                    BorderBrush="{Binding BorderHex, Converter={StaticResource HexBrush}}"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                    AutomationProperties.Name="{Binding Label}">
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding BorderHex, Converter={StaticResource HexBrush}}" />
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxHeight="36" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

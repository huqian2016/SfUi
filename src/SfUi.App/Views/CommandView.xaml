<UserControl x:Class="SfUi.App.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ 実行 (Enter)" Padding="10,2" Margin="0,0,6,0" Command="{Binding ExecuteCommand}" />
                <Button Content="キャンセル" Padding="10,2" Margin="0,0,12,0" Command="{Binding CancelCommand}" />
                <TextBlock Text="履歴:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="300" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          DisplayMemberPath="Summary" ToolTip="最近実行したコマンドを読み込み" />
                <Button Content="⟳" Padding="8,2" Margin="0,0,12,0" Command="{Binding RefreshHistoryCommand}" />
                <Button Content="お気に入り追加" Padding="10,2" Command="{Binding AddFavoriteCommand}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" x:Name="CommandInput" Margin="8,8,8,0" Padding="6,4"
                     FontFamily="Consolas" FontSize="13"
                     Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="sf に渡す引数（例: org list / data query --query SELECT Id FROM Account LIMIT 5）。sf 付きの貼り付けも可" />

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TabControl Grid.Row="2" Margin="8">
                <TabItem Header="標準出力">
                    <TextBox Text="{Binding StdOut}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </TabItem>
                <TabItem Header="標準エラー">
                    <TextBox Text="{Binding StdErr}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>

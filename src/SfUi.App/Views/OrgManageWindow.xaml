<Window x:Class="SfUi.App.Views.OrgManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="780" Width="1280" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>

        <!-- 上部: 対象組織（全タブで共有） -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Main_OrgLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="360" ItemsSource="{Binding Orgs}"
                              SelectedItem="{Binding SelectedOrgRow, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              IsEnabled="{Binding CanInteract}"
                              ToolTip="{loc:Tr OrgManage_OrgComboTip}"
                              AutomationProperties.Name="{loc:Tr Main_OrgLabel}" />
                    <Button Content="{loc:Tr OrgManage_RefreshOrgs}" Margin="8,0,0,0" Padding="10,2"
                            Command="{Binding RefreshOrgsCommand}"
                            IsEnabled="{Binding CanInteract}"
                            AutomationProperties.Name="{loc:Tr OrgManage_RefreshOrgs}" />
                    <ProgressBar Width="70" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="8,0,0,0"
                                 AutomationProperties.AutomationId="OrgLoadingBar"
                                 Visibility="{Binding IsLoadingOrgs, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{loc:Tr Main_OrgLoading}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#555555"
                               Visibility="{Binding IsLoadingOrgs, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{loc:Tr Common_Cancel}" Margin="8,0,0,0" Padding="10,2"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding CanCancel}"
                            AutomationProperties.Name="{loc:Tr Common_Cancel}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#555555" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding OrgListHintText}" Foreground="#B35C00" Margin="0,2,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasOrgListHint, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- 組織タブ: 組織一覧と管理操作 -->
            <TabItem Header="{loc:Tr OrgManage_TabOrgs}" AutomationProperties.Name="{loc:Tr OrgManage_TabOrgs}">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Tr OrgManage_Register}" Padding="10,2"
                                    Command="{Binding ToggleRegisterPanelCommand}"
                                    ToolTip="{loc:Tr OrgManage_RegisterTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_Register}" />
                            <Button Content="{loc:Tr OrgManage_SetDefault}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding SetDefaultCommand}"
                                    IsEnabled="{Binding CanInteract}"
                                    ToolTip="{loc:Tr OrgManage_SetDefaultTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_SetDefault}" />
                            <Button Content="{loc:Tr OrgManage_Open}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding OpenOrgCommand}"
                                    IsEnabled="{Binding CanInteract}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_Open}" />
                            <Button Content="{loc:Tr OrgManage_Login}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding LoginWebCommand}"
                                    IsEnabled="{Binding CanInteract}"
                                    ToolTip="{loc:Tr OrgManage_LoginTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_Login}" />
                            <Button Content="{loc:Tr OrgManage_Logout}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding LogoutCommand}"
                                    IsEnabled="{Binding CanInteract}"
                                    ToolTip="{loc:Tr OrgManage_LogoutTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_Logout}" />
                            <Border Width="1" Background="#CCCCCC" Margin="10,2" />
                            <Button Content="{loc:Tr OrgManage_TestSelected}" Padding="10,2"
                                    Command="{Binding TestSelectedConnectionCommand}"
                                    IsEnabled="{Binding CanTestConnections}"
                                    ToolTip="{loc:Tr OrgManage_TestTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_TestSelected}" />
                            <Button Content="{loc:Tr OrgManage_TestAll}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding TestAllConnectionsCommand}"
                                    IsEnabled="{Binding CanTestConnections}"
                                    ToolTip="{loc:Tr OrgManage_TestTip}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_TestAll}" />
                            <TextBlock Text="{Binding TestProgress}" Foreground="#555555" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- 新規組織の登録パネル -->
                        <Border Margin="0,6,0,0" Padding="8" Background="#F2F6FA" BorderBrush="#B9CCE0" BorderThickness="1"
                                Visibility="{Binding IsRegisterPanelOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr OrgManage_RegisterTitle}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterMethod}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <RadioButton Content="{loc:Tr OrgManage_RegisterMethodWeb}" GroupName="RegisterMethod"
                                                 IsChecked="{Binding RegisterUseWeb, Mode=TwoWay}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{loc:Tr OrgManage_RegisterMethodWeb}" />
                                    <RadioButton Content="{loc:Tr OrgManage_RegisterMethodSfdxUrl}" GroupName="RegisterMethod" Margin="12,0,0,0"
                                                 IsChecked="{Binding RegisterUseSfdxUrl, Mode=TwoWay}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{loc:Tr OrgManage_RegisterMethodSfdxUrl}" />
                                    <RadioButton Content="{loc:Tr OrgManage_RegisterMethodToken}" GroupName="RegisterMethod" Margin="12,0,0,0"
                                                 IsChecked="{Binding RegisterUseAccessToken, Mode=TwoWay}" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{loc:Tr OrgManage_RegisterMethodToken}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Tr OrgManage_AliasLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Width="180" VerticalAlignment="Center"
                                             Text="{Binding RegisterAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Tr OrgManage_RegisterTitle}" />
                                    <CheckBox Content="{loc:Tr OrgManage_RegisterSetDefault}" Margin="16,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding RegisterSetDefault, Mode=TwoWay}"
                                              AutomationProperties.Name="{loc:Tr OrgManage_RegisterSetDefault}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding ShowRegisterInstanceUrl, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterInstanceUrl}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Width="340" VerticalAlignment="Center"
                                             Text="{Binding RegisterInstanceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Tr OrgManage_RegisterInstanceUrl}" />
                                    <TextBlock Text="{Binding RegisterInstanceUrlHint}" Foreground="#666666" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,6,0,0"
                                            Visibility="{Binding ShowRegisterSfdxUrl, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterSfdxUrl}" />
                                    <TextBox Margin="0,2,0,0" Height="54" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding RegisterSfdxUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Tr OrgManage_RegisterSfdxUrl}" />
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterSfdxUrlHint}" Foreground="#666666" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding ShowRegisterAccessToken, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterToken}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <PasswordBox x:Name="RegisterTokenBox" Width="320" VerticalAlignment="Center" PasswordChar="●"
                                                 PasswordChanged="RegisterTokenBox_PasswordChanged"
                                                 AutomationProperties.Name="{loc:Tr OrgManage_RegisterToken}" />
                                    <TextBlock Text="{loc:Tr OrgManage_RegisterTokenHint}" Foreground="#666666" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:Tr OrgManage_RegisterRun}" Padding="10,2"
                                            Command="{Binding RegisterOrgCommand}"
                                            IsEnabled="{Binding CanInteract}"
                                            AutomationProperties.Name="{loc:Tr OrgManage_RegisterRun}" />
                                    <Button Content="{loc:Tr OrgManage_RegisterClose}" Margin="8,0,0,0" Padding="10,2"
                                            Command="{Binding ToggleRegisterPanelCommand}"
                                            AutomationProperties.Name="{loc:Tr OrgManage_RegisterClose}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:Tr OrgManage_AliasLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="180" VerticalAlignment="Center"
                                     Text="{Binding AliasInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Tr OrgManage_AliasHint}"
                                     AutomationProperties.Name="{loc:Tr OrgManage_AliasLabel}" />
                            <Button Content="{loc:Tr OrgManage_SetAlias}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding SetAliasCommand}"
                                    IsEnabled="{Binding CanInteract}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_SetAlias}" />
                            <Border Width="1" Background="#CCCCCC" Margin="10,2" />
                            <TextBlock Text="{loc:Tr OrgManage_TagLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="120" VerticalAlignment="Center"
                                     Text="{Binding TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Tr OrgManage_TagHint}"
                                     AutomationProperties.Name="{loc:Tr OrgManage_TagLabel}" />
                            <TextBlock Text="{loc:Tr OrgManage_NoteLabel}" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <TextBox Width="300" VerticalAlignment="Center"
                                     Text="{Binding NoteInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Tr OrgManage_NoteHint}"
                                     AutomationProperties.Name="{loc:Tr OrgManage_NoteLabel}" />
                            <Button Content="{loc:Tr OrgManage_SaveNote}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding SaveNoteCommand}"
                                    ToolTip="{loc:Tr OrgManage_NoteHint}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_SaveNote}" />
                        </StackPanel>
                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Tr OrgManage_OrgSearch}"
                                 AutomationProperties.Name="{loc:Tr OrgManage_OrgSearch}" />
                    </StackPanel>
                    <DataGrid x:Name="OrgsGrid" ItemsSource="{Binding OrgsView}"
                              SelectedItem="{Binding SelectedOrgRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="28"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColDefault}" Width="54" Binding="{Binding DefaultMark}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColAlias}" Width="110" Binding="{Binding AliasText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColUsername}" Width="195" Binding="{Binding Username}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColOrgId}" Width="155" Binding="{Binding OrgIdText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColType}" Width="90" Binding="{Binding TypeText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColStatus}" Width="95" Binding="{Binding StatusText}" />
                            <DataGridTemplateColumn Header="{loc:Tr OrgManage_ColConnection}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" Margin="4,0"
                                                   ToolTip="{Binding ConnectionDetail}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColTag}" Width="110" Binding="{Binding Tag}" />
                            <DataGridTemplateColumn Header="{loc:Tr OrgManage_ColNote}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}" VerticalAlignment="Center" Margin="4,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColLastBackup}" Width="130" Binding="{Binding LastBackupText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColInstanceUrl}" Width="*" Binding="{Binding InstanceUrlText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ヘルス タブ: 組織の使用量 -->
            <TabItem Header="{loc:Tr OrgManage_TabHealth}" AutomationProperties.Name="{loc:Tr OrgManage_TabHealth}">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:Tr OrgManage_HealthRefresh}" Padding="10,2"
                                Command="{Binding Health.RefreshCommand}"
                                AutomationProperties.Name="{loc:Tr OrgManage_HealthRefresh}" />
                        <Button Content="{loc:Tr Common_Cancel}" Margin="8,0,0,0" Padding="10,2"
                                Command="{Binding Health.CancelLoadCommand}"
                                AutomationProperties.Name="{loc:Tr Common_Cancel}" />
                        <TextBlock Text="{loc:Tr OrgManage_HealthFilterLabel}" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox Width="220" VerticalAlignment="Center"
                                 Text="{Binding Health.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Tr OrgManage_HealthFilter}"
                                 AutomationProperties.Name="{loc:Tr OrgManage_HealthFilter}" />
                        <TextBlock Text="{Binding Health.StatusMessage}" Foreground="#555555" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                    </StackPanel>
                    <DataGrid x:Name="HealthGrid" ItemsSource="{Binding Health.RowsView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="30"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColLimit}" Width="260" Binding="{Binding Label}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColUsed}" Width="120" Binding="{Binding UsedText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColMax}" Width="120" Binding="{Binding MaxText}" />
                            <DataGridTemplateColumn Header="{loc:Tr OrgManage_ColPercent}" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,0">
                                            <ProgressBar Width="110" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding BarValue, Mode=OneWay}"
                                                         VerticalAlignment="Center"
                                                         AutomationProperties.Name="{Binding PercentText}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding PercentText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 移行棚卸し タブ: Workflow / プロセスビルダー / フロー -->
            <TabItem Header="{loc:Tr OrgManage_TabInventory}" AutomationProperties.Name="{loc:Tr OrgManage_TabInventory}">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Tr OrgManage_InvFetch}" Padding="10,2"
                                    Command="{Binding Inventory.FetchCommand}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_InvFetch}" />
                            <Button Content="{loc:Tr Common_Cancel}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding Inventory.CancelLoadCommand}"
                                    AutomationProperties.Name="{loc:Tr Common_Cancel}" />
                            <Button Content="{loc:Tr OrgManage_InvExportCsv}" Margin="8,0,0,0" Padding="10,2"
                                    Command="{Binding Inventory.ExportCsvCommand}"
                                    AutomationProperties.Name="{loc:Tr OrgManage_InvExportCsv}" />
                            <Border Width="1" Background="#CCCCCC" Margin="10,2" />
                            <TextBlock Text="{loc:Tr OrgManage_InvKindLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="180" VerticalAlignment="Center"
                                      ItemsSource="{Binding Inventory.KindOptions}"
                                      SelectedIndex="{Binding Inventory.KindFilterIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Tr OrgManage_InvKindLabel}" />
                            <CheckBox Content="{loc:Tr OrgManage_InvActiveOnly}" Margin="12,0,0,0" VerticalAlignment="Center"
                                      IsChecked="{Binding Inventory.ShowActiveOnly, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Tr OrgManage_InvActiveOnly}" />
                            <TextBox Width="220" VerticalAlignment="Center" Margin="12,0,0,0"
                                     Text="{Binding Inventory.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Tr OrgManage_InvSearch}"
                                     AutomationProperties.Name="{loc:Tr OrgManage_InvSearch}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Inventory.SummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Inventory.WarningText}" Foreground="#B26500" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding Inventory.HasWarning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Inventory.StatusMessage}" Foreground="#555555" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding Inventory.RowsView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" RowHeight="28"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr OrgManage_ColOpen}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{loc:Tr OrgManage_OpenPage}" Padding="6,0" Margin="2,0" FontSize="11"
                                                ToolTip="{loc:Tr OrgManage_OpenPageTip}"
                                                AutomationProperties.Name="{loc:Tr OrgManage_OpenPage}"
                                                Command="{Binding DataContext.Inventory.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColKind}" Width="130" Binding="{Binding KindText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColName}" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColApiName}" Width="200" Binding="{Binding ApiNameText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColObject}" Width="170" Binding="{Binding ObjectText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColActive}" Width="90" Binding="{Binding ActiveText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColSubType}" Width="220" Binding="{Binding SubTypeText}" />
                            <DataGridTextColumn Header="{loc:Tr OrgManage_ColLastModified}" Width="150" Binding="{Binding LastModifiedText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

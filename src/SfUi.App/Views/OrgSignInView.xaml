<UserControl x:Class="SfUi.App.Views.OrgSignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppToolbarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LabelInstance}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBox Width="300" Margin="0,2,8,2" Text="{Binding InstanceUrl, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="OrgSignInInstance" />
                <Button Content="{Binding OpenText}" Padding="10,2" Margin="0,2,6,2" Click="OnOpenClick"
                        AutomationProperties.AutomationId="OrgSignInOpen" />
                <Button Content="{Binding ReloadText}" Padding="10,2" Margin="0,2,12,2" Click="OnReloadClick"
                        AutomationProperties.AutomationId="OrgSignInReload" />
                <Border Width="1" Height="20" VerticalAlignment="Center" Background="{DynamicResource AppDividerBrush}" Margin="0,2,12,2" />
                <TextBlock Text="{Binding LabelAlias}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                <TextBox Width="150" Margin="0,2,8,2" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="OrgSignInAlias" />
                <Button Content="{Binding RegisterText}" Padding="12,2" Margin="0,2,6,2" Command="{Binding RegisterCommand}"
                        FontWeight="SemiBold" AutomationProperties.AutomationId="OrgSignInRegister" />
                <Button Content="{Binding ResetText}" Padding="10,2" Margin="0,2,0,2" Command="{Binding ResetCommand}"
                        AutomationProperties.AutomationId="OrgSignInReset" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AppSubtleBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="OrgSignInStatus" />
        </Border>

        <wv2:WebView2 x:Name="Browser" AutomationProperties.AutomationId="OrgSignInWeb" />
    </DockPanel>
</UserControl>

<Window x:Class="SfUi.App.Views.BackupCompareRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="620" Width="1100" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>

        <!-- 上部: 検索とページング -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr BackupRecords_Search}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Width="280" VerticalAlignment="Center"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Tr BackupRecords_Search}"
                         AutomationProperties.Name="{loc:Tr BackupRecords_Search}" />
                <Button Content="{loc:Tr BackupRecords_Prev}" Margin="10,0,0,0" Padding="8,2"
                        Command="{Binding PrevPageCommand}"
                        AutomationProperties.Name="{loc:Tr BackupRecords_Prev}" />
                <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <Button Content="{loc:Tr BackupRecords_Next}" Margin="8,0,0,0" Padding="8,2"
                        Command="{Binding NextPageCommand}"
                        AutomationProperties.Name="{loc:Tr BackupRecords_Next}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#666666" Margin="16,0,0,0" VerticalAlignment="Center" />
                <views:HelpButton Topic="BackupCompareRecords" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 下部: 上限到達の注意 -->
        <Border DockPanel.Dock="Bottom" Background="#FFF8E1" BorderBrush="#E8D9A0" BorderThickness="0,1,0,0"
                Padding="8,4" Visibility="{Binding Truncated, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding TruncatedText}" Foreground="#8A6D00" TextWrapping="Wrap" />
        </Border>

        <DataGrid x:Name="DiffsGrid" Margin="8" ItemsSource="{Binding PageRows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="26" EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                            <Setter Property="Background" Value="#E6F4EA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                            <Setter Property="Background" Value="#FCE8E6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:Tr BackupRecords_OpenRecord}" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="↗" Padding="6,0" Margin="2,0" FontSize="11"
                                    IsEnabled="{Binding HasLink}"
                                    ToolTip="{loc:Tr BackupRecords_OpenRecord}"
                                    AutomationProperties.Name="{loc:Tr BackupRecords_OpenRecord}"
                                    Command="{Binding DataContext.OpenRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Tr BackupCompare_ColKind}" Width="70" Binding="{Binding KindText}" />
                <DataGridTextColumn Header="Id" Width="200" Binding="{Binding Id}" />
                <DataGridTextColumn Header="{loc:Tr Restore_Details}" Width="200" Binding="{Binding Display}" />
                <DataGridTextColumn Header="{loc:Tr BackupCompare_ColChange}" Width="*" Binding="{Binding ChangeSummary}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

<Window x:Class="SfUi.App.Views.FormOutputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        xmlns:services="clr-namespace:SfUi.App.Services"
        Title="{Binding Title}"
        Height="760" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <services:PngToImageConverter x:Key="PngToImage" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{Binding LabelRender}" Click="OnRender" Padding="16,4"
                            AutomationProperties.AutomationId="FormRender" />
                    <Button Content="{Binding LabelPrint}" Click="OnPrint" Padding="16,4" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="FormPrint" />
                    <Button Content="{Binding LabelCancel}" Click="OnCancel" Padding="12,4" Margin="8,0,0,0"
                            IsCancel="True" AutomationProperties.AutomationId="FormCancel" />
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#333333"
                               AutomationProperties.AutomationId="FormStatus" />
                    <TextBlock Text="{Binding OutputHint}" Foreground="#777777" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- テンプレート -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding LabelRegion}" Style="{StaticResource FieldLabel}" />
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}"
                          DisplayMemberPath="Label" Margin="0,0,0,8"
                          AutomationProperties.AutomationId="FormRegion" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding LabelTemplate}" Style="{StaticResource FieldLabel}" />
                <ListBox ItemsSource="{Binding Forms}" SelectedItem="{Binding SelectedForm}"
                         AutomationProperties.AutomationId="FormTemplate">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Category}" Foreground="#777777" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 差し込み + 形式 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding LabelValues}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding CategoryText}" Foreground="#1A73E8" FontSize="11" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Values}" AutomationProperties.AutomationId="FormValues">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}" Foreground="#555555" FontSize="11" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FormValueBox" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding LabelOutput}" Style="{StaticResource FieldLabel}" Margin="0,10,0,3" />
                    <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormOutputName" />

                    <TextBlock Text="{Binding LabelFormats}" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                    <WrapPanel>
                        <CheckBox Content="HTML" IsChecked="{Binding WriteHtml}" Margin="0,0,12,0"
                                  AutomationProperties.AutomationId="FormHtml" />
                        <CheckBox Content="PDF" IsChecked="{Binding WritePdf}" Margin="0,0,12,0"
                                  AutomationProperties.AutomationId="FormPdf" />
                        <CheckBox Content="SVG" IsChecked="{Binding WriteSvg}" Margin="0,0,12,0"
                                  AutomationProperties.AutomationId="FormSvg" />
                        <CheckBox Content="PNG" IsChecked="{Binding WritePng}" Margin="0,0,12,0"
                                  AutomationProperties.AutomationId="FormPng" />
                        <CheckBox Content="JPEG" IsChecked="{Binding WriteJpeg}"
                                  AutomationProperties.AutomationId="FormJpeg" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- プレビュー -->
            <Border Grid.Column="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Image Source="{Binding PreviewPng, Converter={StaticResource PngToImage}}"
                           Stretch="Uniform" StretchDirection="DownOnly"
                           AutomationProperties.AutomationId="FormPreviewImage" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

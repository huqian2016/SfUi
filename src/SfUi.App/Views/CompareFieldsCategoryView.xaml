<UserControl x:Class="SfUi.App.Views.CompareFieldsCategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SfUi.App.Views"
             xmlns:loc="clr-namespace:SfUi.App">
    <DockPanel>

        <!-- ツールバー: 比較するオブジェクトの選択（選択で再比較・状態は保存される） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Tr Compare_FieldsObjectLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FieldsObjectComboBox" Width="340" IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Display"
                          ItemsSource="{Binding Objects}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <views:CompareCategoryView />
    </DockPanel>
</UserControl>

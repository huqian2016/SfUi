<UserControl x:Class="SfUi.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" MaxWidth="860" HorizontalAlignment="Left">

                <TextBlock Text="設定" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{Binding DataRootText}" Foreground="Gray" Margin="0,2,0,4" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="データフォルダを開く" Padding="10,2" Margin="0,0,6,0" Command="{Binding OpenDataFolderCommand}" />
                    <Button Content="再読込" Padding="10,2" Command="{Binding ReloadCommand}" ToolTip="ファイルの現在値でフォームを初期化" />
                </StackPanel>

                <GroupBox Header="Salesforce CLI" Padding="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="sf パス:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Padding="4,2" FontFamily="Consolas"
                                     Text="{Binding SfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="sf.cmd のフルパス。空欄なら自動検出（環境変数 SFUI_SF_PATH → Program Files → PATH）" />
                            <Button Grid.Column="2" Content="参照…" Padding="10,2" Margin="6,0,0,0" Command="{Binding BrowseSfCommand}" />
                            <Button Grid.Column="3" Content="クリア" Padding="10,2" Margin="6,0,0,0" Command="{Binding ClearSfPathCommand}"
                                    ToolTip="空欄に戻して自動検出を使用" />
                        </Grid>
                        <TextBlock Text="{Binding DetectedSummary}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="ツール" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ターミナル:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Padding="4,2" FontFamily="Consolas"
                                     Text="{Binding TerminalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Windows Terminal (wt.exe) のフルパス。空欄なら自動検出" />
                            <Button Grid.Column="2" Content="参照…" Padding="10,2" Margin="6,0,0,0" Command="{Binding BrowseTerminalCommand}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="VS Code:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Padding="4,2" FontFamily="Consolas"
                                     Text="{Binding VsCodePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="code.cmd のフルパス。空欄なら自動検出" />
                            <Button Grid.Column="2" Content="参照…" Padding="10,2" Margin="6,0,0,0" Command="{Binding BrowseVsCodeCommand}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="履歴と結果" Padding="8" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="履歴の上限:" VerticalAlignment="Center" Width="110" />
                            <TextBox Width="100" Padding="4,2" Text="{Binding HistoryLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="件 / 種別" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="結果保存閾値:" VerticalAlignment="Center" Width="110" />
                            <TextBox Width="100" Padding="4,2" Text="{Binding ThresholdKbText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="KB を超えた結果は results/ に分離保存" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Content="サンプル履歴を投入（SOQL / 匿名Apex / コマンド / REST）" Padding="10,2" Margin="0,10,0,0"
                                HorizontalAlignment="Left" Command="{Binding SeedSamplesCommand}"
                                ToolTip="よく使うテンプレートを履歴に追加します（同じ内容はスキップ）" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="実行前確認" Padding="8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="確認ポリシー:" VerticalAlignment="Center" Width="110" />
                        <ComboBox Width="200" ItemsSource="{Binding ConfirmPolicyLabels}"
                                  SelectedItem="{Binding ConfirmPolicyLabel, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                    <Button Content="保存" Padding="18,4" FontWeight="Bold" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

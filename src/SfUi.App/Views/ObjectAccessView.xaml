<UserControl x:Class="SfUi.App.Views.ObjectAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App"
             FontSize="13">
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Top" Padding="4,4,4,6" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Access_Reload}" Command="{Binding ReloadCommand}" Padding="12,3"
                        AutomationProperties.AutomationId="ObjectAccessReload" />
                <TextBlock Text="{Binding SummaryText}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#555555"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" AutomationProperties.AutomationId="ObjectAccessGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr Access_ColKind}" Binding="{Binding Kind}" Width="120" />
                <DataGridTextColumn Header="{loc:Tr Access_ColLabel}" Binding="{Binding Label}" Width="220" />
                <DataGridTextColumn Header="{loc:Tr Access_ColApiName}" Binding="{Binding ApiName}" Width="210" />
                <DataGridTextColumn Header="{loc:Tr Access_ColCustom}" Binding="{Binding Custom}" Width="80" />
                <DataGridTextColumn Header="{loc:Tr Access_ColRead}" Binding="{Binding Read}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr Access_ColCreate}" Binding="{Binding Create}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr Access_ColEdit}" Binding="{Binding Edit}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr Access_ColDelete}" Binding="{Binding Delete}" Width="70" />
                <DataGridTextColumn Header="{loc:Tr Access_ColViewAllRecords}" Binding="{Binding ViewAllRecords}" Width="140" />
                <DataGridTextColumn Header="{loc:Tr Access_ColModifyAllRecords}" Binding="{Binding ModifyAllRecords}" Width="150" />
                <DataGridTextColumn Header="{loc:Tr Access_ColViewAllFields}" Binding="{Binding ViewAllFields}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

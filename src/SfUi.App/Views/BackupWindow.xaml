<Window x:Class="SfUi.App.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="820" Width="1400" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- 上部: 対象組織（両タブで共有） -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Org.DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Org.Username}" Foreground="#666666" Margin="8,0,0,0" VerticalAlignment="Center" />
                <views:HelpButton Topic="Backup" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <TabItem Header="{loc:Tr Backup_TabBackup}">
                <views:BackupTabView DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="{loc:Tr Backup_TabRestore}">
                <views:RestoreTabView DataContext="{Binding Restore}" />
            </TabItem>
            <TabItem Header="{loc:Tr BackupCompare_Tab}">
                <views:CompareTabView DataContext="{Binding Compare}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="SfUi.App.Views.CompareRecordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="640" Width="1000" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- 上部: 対象オブジェクト / 項目数 / 差分件数 -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <views:HelpButton Topic="RecordDetail" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeaderText}" Foreground="#555555" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- 差分のある項目のみ黄色でハイライトする -->
                        <DataTrigger Binding="{Binding IsDiff}" Value="True">
                            <Setter Property="Background" Value="#FFF59D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>

<UserControl x:Class="SfUi.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="⟳ 一覧更新" Padding="10,2" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                <Button Content="取得" Padding="10,2" Margin="0,0,6,0" Command="{Binding FetchCommand}"
                        ToolTip="選択したログの内容を表示（ダブルクリックでも可）" />
                <Button Content="保存…" Padding="10,2" Command="{Binding SaveLogCommand}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F9FB">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="開始時刻" Binding="{Binding StartTimeLabel}" Width="170" />
                    <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="120" />
                    <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="70" />
                    <DataGridTextColumn Header="時間(ms)" Binding="{Binding DurationMs}" Width="70" />
                    <DataGridTextColumn Header="サイズ" Binding="{Binding LogLength}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBox Grid.Column="2" Text="{Binding LogContent}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="SfUi.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.App">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Log_Refresh}" Padding="10,2" Margin="0,0,6,0" Command="{Binding RefreshCommand}" />
                <Button Content="{loc:Tr Log_Fetch}" Padding="10,2" Margin="0,0,6,0" Command="{Binding FetchCommand}"
                        ToolTip="{loc:Tr Log_FetchTip}" />
                <Button Content="{loc:Tr Log_Save}" Padding="10,2" Command="{Binding SaveLogCommand}" />
                <Button Content="{loc:Tr LogAnalyze_Button}" Padding="10,2" Margin="6,0,0,0" Command="{Binding AnalyzeCommand}"
                        ToolTip="{loc:Tr LogAnalyze_Tip}" AutomationProperties.Name="{loc:Tr LogAnalyze_Button}" />
                <Button Content="{loc:Tr LogAnalyze_OpenFile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding OpenLogFileCommand}"
                        AutomationProperties.Name="{loc:Tr LogAnalyze_OpenFile}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F7F9FB">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Log_ColStart}" Binding="{Binding StartTimeLabel}" Width="170" />
                    <DataGridTextColumn Header="{loc:Tr Log_ColOperation}" Binding="{Binding Operation}" Width="120" />
                    <DataGridTextColumn Header="{loc:Tr Log_ColStatus}" Binding="{Binding Status}" Width="70" />
                    <DataGridTextColumn Header="{loc:Tr Log_ColDuration}" Binding="{Binding DurationMs}" Width="70" />
                    <DataGridTextColumn Header="{loc:Tr Log_ColSize}" Binding="{Binding LogLength}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBox Grid.Column="2" Text="{Binding LogContent}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
    </DockPanel>
</UserControl>

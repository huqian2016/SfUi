<Window x:Class="SfUi.App.Views.CompareOrgsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="760" Width="1280" MinWidth="980" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- 上部: 組織選択 + 操作 -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Compare_SelectOrgs}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding Orgs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" Margin="0,0,14,0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          ToolTip="{Binding Username}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{loc:Tr Compare_Refetch}" Padding="10,2"
                            Command="{Binding RefreshCurrentCommand}" IsEnabled="{Binding CanInteract}" />
                    <CheckBox Content="{loc:Tr Compare_DiffOnly}" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding DiffOnly, Mode=TwoWay}" />
                    <Button Content="{loc:Tr Compare_ExportCsv}" Padding="10,2" Margin="12,0,0,0"
                            Command="{Binding ExportCsvCommand}" IsEnabled="{Binding CanInteract}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="#555555" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- カテゴリ（タブ） -->
        <TabControl ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="8">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <views:CompareCategoryView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>

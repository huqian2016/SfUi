<UserControl x:Class="SfUi.App.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- フォーム -->
            <Grid Grid.Row="0" Margin="8,8,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="操作:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation, Mode=TwoWay}" Margin="0,2,12,2" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="ソースパス:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <TextBox Grid.Row="0" Grid.Column="3" Margin="0,2,4,2" VerticalContentAlignment="Center"
                         Text="{Binding SourceDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="デプロイするソース（例: force-app）。空欄なら変更分をデプロイ（tracked changes）" />
                <Button Grid.Row="0" Grid.Column="4" Content="参照…" Padding="8,2" Margin="0,2,12,2" Command="{Binding BrowseSourceDirCommand}" />

                <TextBlock Grid.Row="0" Grid.Column="5" Text="マニフェスト:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <TextBox Grid.Row="0" Grid.Column="6" Margin="0,2,4,2" VerticalContentAlignment="Center"
                         Text="{Binding Manifest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="package.xml のパス（省略可）" />
                <Button Grid.Row="0" Grid.Column="7" Content="参照…" Padding="8,2" Margin="0,2,0,2" Command="{Binding BrowseManifestCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="テストレベル:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TestLevels}" SelectedItem="{Binding TestLevel, Mode=TwoWay}" Margin="0,2,12,2" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="指定テスト:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2,4,2" VerticalContentAlignment="Center"
                         Text="{Binding Tests, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RunSpecifiedTests のときの Apex テスト名（カンマ区切り）" />

                <TextBlock Grid.Row="1" Grid.Column="4" Text="--wait:" VerticalAlignment="Center" Margin="0,2,4,2" />
                <TextBox Grid.Row="1" Grid.Column="5" Width="40" Margin="0,2,12,2" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                         Text="{Binding WaitMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox Grid.Row="1" Grid.Column="6" Margin="0,2,4,2" VerticalContentAlignment="Center"
                         Text="{Binding JobId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="レポート / クイックデプロイ用のジョブ ID（空欄なら --use-most-recent）" />
                <CheckBox Grid.Row="1" Grid.Column="7" Content="最新を使用" VerticalAlignment="Center" Margin="0,2,0,2"
                          IsChecked="{Binding UseMostRecent, Mode=TwoWay}"
                          ToolTip="--use-most-recent（直近の検証/デプロイを使用）" />

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="▶ 実行" Padding="12,2" Margin="0,0,6,0" Command="{Binding ExecuteCommand}" />
                    <Button Content="キャンセル" Padding="10,2" Margin="0,0,12,0" Command="{Binding CancelCommand}" />
                    <Button Content="お気に入り追加" Padding="10,2" Margin="0,0,12,0" Command="{Binding AddFavoriteCommand}" />
                    <TextBlock Text="履歴:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="280" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                              DisplayMemberPath="Summary" ToolTip="最近のデプロイ操作を読み込み" />
                    <Button Content="⟳" Padding="8,2" Margin="6,0,0,0" Command="{Binding RefreshHistoryCommand}" />
                </StackPanel>
            </Grid>

            <!-- 実行コマンド プレビュー -->
            <TextBox Grid.Row="1" Margin="8,0,8,4" IsReadOnly="True" Background="#F5F5F5" FontFamily="Consolas" FontSize="12"
                     Text="{Binding CommandPreview, Mode=OneWay}" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                     ToolTip="実行されるコマンド（コピー可）" />

            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBox Grid.Row="3" Margin="8,4,8,8" Text="{Binding OutputText}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     ToolTip="sf の出力（JSON は整形して表示）" />
        </Grid>
    </DockPanel>
</UserControl>

<Window x:Class="SfUi.App.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        xmlns:views="clr-namespace:SfUi.App.Views"
        Title="{Binding Title}"
        Height="760" Width="1280" MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <views:HelpButton Topic="Reports" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                <Button Content="{Binding LabelNew}" Command="{Binding NewReportCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ReportsNew" />
                <Button Content="{Binding LabelEdit}" Command="{Binding EditReportCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ReportsEdit" />
                <Button Content="{Binding LabelDuplicate}" Command="{Binding DuplicateReportCommand}" Style="{StaticResource ToolButton}" />
                <Button Content="{Binding LabelDelete}" Command="{Binding DeleteReportCommand}" Style="{StaticResource ToolButton}" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" VerticalAlignment="Center" />
                <Button Content="{Binding LabelRun}" Command="{Binding RunCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ReportsRun" />
                <!-- WPF は Command 駆動（UIA の Toggle が Command を発火する） -->
                <CheckBox Content="{Binding LabelLive}" IsChecked="{Binding IsLive, Mode=OneWay}"
                          Command="{Binding ToggleLiveCommand}" VerticalAlignment="Center" Margin="6,0,10,0"
                          AutomationProperties.AutomationId="ReportsLive" />
                <TextBlock Text="{Binding LabelInterval}" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding LiveIntervalText}" VerticalAlignment="Center" Margin="0,0,12,0"
                           AutomationProperties.AutomationId="ReportsInterval" />
                <Button Content="{Binding LabelExport}" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ReportsExport" />
                <Button Content="{Binding LabelExportForm}" Command="{Binding ExportFormCommand}" Style="{StaticResource ToolButton}"
                        AutomationProperties.AutomationId="ReportsExportForm" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ステータス バー -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" AutomationProperties.AutomationId="ReportsStatus" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" />
                <TextBlock Text="{Binding RowCountText}" AutomationProperties.AutomationId="ReportsRowCount" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" />
                <TextBlock Text="{Binding LastRunText}" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" />
                <TextBlock Text="{Binding NextUpdateText}" AutomationProperties.AutomationId="ReportsNextRun" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" />
                <TextBlock Text="{Binding SelectedOrgName}" Foreground="#555555" />
            </StackPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- レポート一覧 -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}"
                     AutomationProperties.AutomationId="ReportsList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ObjectName}" Foreground="#777777" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TruncatedWarning}" Foreground="#B45309" Margin="0,0,0,6" TextWrapping="Wrap"
                           Visibility="{Binding HasTruncatedWarning, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="ReportsTruncated" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding ResultView}" AutoGenerateColumns="True" IsReadOnly="True"
                          HeadersVisibility="All" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          RowHeight="22" AlternatingRowBackground="#FAFAFA"
                          AutomationProperties.AutomationId="ReportsGrid" />

                <GroupBox Grid.Row="2" Header="{Binding LabelGroups}" Margin="0,8,0,0"
                          Visibility="{Binding HasGroups, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding Groups}" AutomationProperties.AutomationId="ReportsGroups">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="#1A73E8" Margin="12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MetricsText}" Foreground="#555555" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

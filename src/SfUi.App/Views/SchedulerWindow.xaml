<Window x:Class="SfUi.App.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SfUi.App.Views"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{loc:Tr Sched_Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="780" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="0,0,8,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <views:HelpButton Topic="Scheduler" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding NextRunText}" VerticalAlignment="Center"
                           Foreground="#555555" AutomationProperties.AutomationId="SchedulerNextRun" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr Sched_NewJob}" Command="{Binding NewJobCommand}"
                            Style="{StaticResource ToolButton}"
                            AutomationProperties.AutomationId="SchedulerNewJob" />
                    <Button Content="{loc:Tr Sched_RunNow}" Command="{Binding RunNowCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}"
                            AutomationProperties.AutomationId="SchedulerRunNow" />
                    <Button Content="{loc:Tr Sched_EditJob}" Command="{Binding EditJobCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}"
                            AutomationProperties.AutomationId="SchedulerEditJob" />
                    <Button Content="{loc:Tr Sched_ToggleEnabled}" Command="{Binding ToggleEnabledCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}"
                            AutomationProperties.AutomationId="SchedulerToggleEnabled" />
                    <Button Content="{loc:Tr Sched_SkipNext}" Command="{Binding SkipNextCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}" />
                    <Button Content="{loc:Tr Sched_DuplicateJob}" Command="{Binding DuplicateJobCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}" />
                    <Button Content="{loc:Tr Sched_DeleteJob}" Command="{Binding DeleteJobCommand}"
                            CommandParameter="{Binding SelectedJob}" Style="{StaticResource ToolButton}" />
                    <Button Content="{loc:Tr Sched_Refresh}" Command="{Binding RefreshAllCommand}"
                            Style="{StaticResource ToolButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ステータス バー -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" AutomationProperties.AutomationId="SchedulerStatus" />
                <TextBlock Text="   |   " Foreground="#AAAAAA" />
                <TextBlock Text="{Binding NextRunText}" Foreground="#555555" />
                <Border Margin="12,0,0,0" Padding="6,1" CornerRadius="8" Background="#E3F4EA"
                        Visibility="{Binding IsKeepAwakeActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr Sched_KeepAwake}" Foreground="#0B6E4F" FontSize="11" />
                </Border>
                <Border Margin="12,0,0,0" Padding="6,1" CornerRadius="8" Background="#FDECEA"
                        Visibility="{Binding IsLockHeldByOther, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Tr Sched_LockHeldByOther}" Foreground="#B3261E" FontSize="11" />
                </Border>
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- ===== カレンダー ===== -->
            <TabItem Header="{loc:Tr Sched_TabCalendar}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="520" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.1*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="◀" Command="{Binding PrevMonthCommand}" Style="{StaticResource NavButton}"
                                    ToolTip="{loc:Tr Sched_PrevMonth}" />
                            <TextBlock Text="{Binding MonthText}" FontSize="16" FontWeight="SemiBold"
                                       Margin="10,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="SchedulerMonth" />
                            <Button Content="▶" Command="{Binding NextMonthCommand}" Style="{StaticResource NavButton}"
                                    ToolTip="{loc:Tr Sched_NextMonth}" />
                            <Button Content="{loc:Tr Sched_Today}" Command="{Binding GoTodayCommand}"
                                    Margin="10,0,0,0" Padding="10,2" />
                        </StackPanel>

                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekdayHeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="#666666"
                                               Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Days}"
                                      AutomationProperties.AutomationId="SchedulerCalendar">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="1"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="3" Padding="4"
                                                MinHeight="74">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#E8F0FE" />
                                                            <Setter Property="BorderBrush" Value="#1A73E8" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrentMonth}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DayText}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#333333" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                    <Setter Property="Background" Value="#1A73E8" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSunday}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C5221F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C5221F" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Jobs}" Margin="0,2,0,0"
                                                              MaxHeight="56" ClipToBounds="True">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                                       Foreground="#1A73E8" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <!-- 右: 日別予定 + 詳細 -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedDayHeader}" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,6"
                                   AutomationProperties.AutomationId="SchedulerDayHeader" />

                        <Border DockPanel.Dock="Bottom" Background="#FAFAFA" BorderBrush="#E2E6EC" BorderThickness="1"
                                CornerRadius="4" Padding="10" Margin="0,8,0,0" MinHeight="170">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Sched_SelectedJobTitle}" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedJob.Name}" FontWeight="SemiBold" FontSize="14"
                                           AutomationProperties.AutomationId="SchedulerSelectedJobName" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Sched_TypeLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJob.TypeLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Sched_ScheduleLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedJob.ScheduleLabel}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Sched_NextRunLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedJob.NextRunText}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Sched_LastRunLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedJob.LastRunText}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Sched_OrgLabel}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedJob.OrgLabel}" />
                                </Grid>
                                <Border Background="#FDECEA" BorderBrush="#F3B6B0" BorderThickness="1" CornerRadius="4"
                                        Padding="8,4" Margin="0,8,0,0"
                                        Visibility="{Binding HasSelectedJobWarning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Tr Sched_ShellWarning}" Foreground="#B3261E"
                                               TextWrapping="Wrap" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding SelectedDayJobs}" SelectedItem="{Binding SelectedJob}"
                                 AutomationProperties.AutomationId="SchedulerDayAgenda">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#1A73E8" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Foreground="#777777"
                                                   FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== 実行履歴 ===== -->
            <TabItem Header="{loc:Tr Sched_TabHistory}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{loc:Tr Sched_HistoryHeader}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Button Content="{loc:Tr Sched_Refresh}" Command="{Binding RefreshAllCommand}"
                                Margin="16,0,0,0" Padding="10,2" />
                        <Button Content="{loc:Tr Report_Export}" Command="{Binding ExportReportCommand}"
                                Margin="8,0,0,0" Padding="10,2"
                                AutomationProperties.AutomationId="SchedulerExportReport" />
                        <TextBlock Text="{Binding RetentionText}" Foreground="#777777" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="11" />
                        <TextBlock Text="{loc:Tr Sched_HistoryEmpty}" Foreground="#888888" VerticalAlignment="Center"
                                   Margin="16,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Runs.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="24"
                              AutomationProperties.AutomationId="SchedulerRunHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnTime}" Binding="{Binding StartedAtText}" Width="150" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnJob}" Binding="{Binding JobName}" Width="*" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnType}" Binding="{Binding TypeLabel}" Width="150" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnStatus}" Binding="{Binding StatusLabel}" Width="90" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnDuration}" Binding="{Binding DurationText}" Width="80" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnOrg}" Binding="{Binding TargetOrg}" Width="140" />
                            <DataGridTextColumn Header="{loc:Tr Sched_ColumnResult}" Binding="{Binding Summary}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding SelectedRun.Error}" Foreground="#B3261E"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Border Grid.Row="3" BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Sched_DetailTitle}" FontWeight="SemiBold"
                                       Margin="8,4" />
                            <TextBox Text="{Binding SelectedRun.OutputPreview}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                     AutomationProperties.AutomationId="SchedulerRunOutput" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

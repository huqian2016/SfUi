<Window x:Class="SfUi.App.Views.ScratchOrgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.App"
        Title="{Binding Title}"
        Icon="pack://application:,,,/SfUi.ico"
        Height="820" Width="1320" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>

        <!-- 上部: Dev Hub とプロファイル（全タブで共有） -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Scratch_DevHubLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="DevHubComboBox" Width="320"
                              ItemsSource="{Binding Orgs}"
                              SelectedItem="{Binding SelectedDevHub, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip="{loc:Tr Scratch_DevHubTip}"
                              AutomationProperties.AutomationId="ScratchDevHubCombo"
                              AutomationProperties.Name="{loc:Tr Scratch_DevHubLabel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DevHubDisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{loc:Tr Scratch_RefreshOrgs}" Margin="6,0,0,0" Padding="10,2"
                            Command="{Binding RefreshOrgsCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="{loc:Tr Scratch_RefreshOrgs}" />
                    <ProgressBar Width="70" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="8,0,0,0"
                                 AutomationProperties.AutomationId="ScratchOrgLoadingBar"
                                 Visibility="{Binding IsLoadingOrgs, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{loc:Tr Scratch_ProfileLabel}" Margin="16,0,4,0" VerticalAlignment="Center" />
                    <ComboBox Width="220"
                              ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip="{loc:Tr Scratch_ProfileTip}"
                              AutomationProperties.AutomationId="ScratchProfileCombo" />
                    <Button Content="{loc:Tr Scratch_NewProfile}" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding NewProfileCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="{loc:Tr Scratch_NewProfile}" />
                    <Button Content="{loc:Tr Scratch_SaveProfile}" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding SaveProfileCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.AutomationId="ScratchSaveProfile"
                            AutomationProperties.Name="{loc:Tr Scratch_SaveProfile}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ScratchStatus" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- 作成タブ -->
            <TabItem Header="{loc:Tr Scratch_TabCreate}" AutomationProperties.AutomationId="ScratchTabCreate">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_ParamsHeader}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Scratch_DurationLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DurationDays, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                 AutomationProperties.AutomationId="ScratchDuration" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Scratch_WaitLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WaitMinutes, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                 AutomationProperties.AutomationId="ScratchWait" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Scratch_AliasPatternLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AliasPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,4" ToolTip="{loc:Tr Scratch_AliasPatternTip}"
                                                 AutomationProperties.AutomationId="ScratchAliasPattern" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Scratch_ShapeLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OrgShapeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{loc:Tr Scratch_ShapeTip}"
                                                 AutomationProperties.AutomationId="ScratchShapeId" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Scratch_SnapshotLabel}" VerticalAlignment="Center" Margin="0,4,0,0" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SnapshotName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4,0,0" ToolTip="{loc:Tr Scratch_SnapshotTip}"
                                                 AutomationProperties.AutomationId="ScratchSnapshotName" />
                                    </Grid>
                                    <CheckBox Content="{loc:Tr Scratch_SetDefault}" IsChecked="{Binding SetDefault, Mode=TwoWay}" Margin="0,6,0,0"
                                              AutomationProperties.AutomationId="ScratchSetDefault" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_ResourcesHeader}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <CheckBox Content="{loc:Tr Scratch_UseMetadata}" IsChecked="{Binding UseMetadata, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseMetadata" />
                                    <CheckBox Content="{loc:Tr Scratch_UseCustomMetadata}" IsChecked="{Binding UseCustomMetadata, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseCustomMetadata" />
                                    <CheckBox Content="{loc:Tr Scratch_UsePermissionSets}" IsChecked="{Binding UsePermissionSets, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUsePermissionSets" />
                                    <CheckBox Content="{loc:Tr Scratch_UseSeedData}" IsChecked="{Binding UseSeedData, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseSeedData" />
                                    <CheckBox Content="{loc:Tr Scratch_UseStaticResources}" IsChecked="{Binding UseStaticResources, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseStaticResources" />
                                    <CheckBox Content="{loc:Tr Scratch_UseConnectedApps}" IsChecked="{Binding UseConnectedApps, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseConnectedApps" />
                                    <CheckBox Content="{loc:Tr Scratch_UseReports}" IsChecked="{Binding UseReports, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseReports" />
                                    <CheckBox Content="{loc:Tr Scratch_UseApexScripts}" IsChecked="{Binding UseApexScripts, Mode=TwoWay}" Margin="0,0,0,4"
                                              ToolTip="{loc:Tr Scratch_UseApexScriptsTip}"
                                              AutomationProperties.AutomationId="ScratchUseApexScripts" />
                                    <CheckBox Content="{loc:Tr Scratch_UseExperienceCloud}" IsChecked="{Binding UseExperienceCloud, Mode=TwoWay}" Margin="0,0,0,3"
                                              ToolTip="{loc:Tr Scratch_UseExperienceCloudTip}"
                                              AutomationProperties.AutomationId="ScratchUseExperienceCloud" />
                                    <CheckBox Content="{loc:Tr Scratch_UseNamedCredentials}" IsChecked="{Binding UseNamedCredentials, Mode=TwoWay}" Margin="0,0,0,4"
                                              ToolTip="{loc:Tr Scratch_UseNamedCredentialsTip}"
                                              AutomationProperties.AutomationId="ScratchUseNamedCredentials" />
                                    <TextBlock Text="{loc:Tr Scratch_SourcesHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="{loc:Tr Scratch_AddExperienceSettings}" Padding="8,2"
                                                Command="{Binding AddExperienceSettingsCommand}"
                                                ToolTip="{loc:Tr Scratch_ExperienceHint}"
                                                AutomationProperties.AutomationId="ScratchAddExperience" />
                                    </StackPanel>
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="{loc:Tr Scratch_NamedCredentialPresetsLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <ComboBox Width="120" ItemsSource="{Binding NamedCredentialPresetNames}"
                                                  SelectedItem="{Binding SelectedNamedCredentialPreset, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="ScratchPresetCombo" />
                                        <Button Content="{loc:Tr Scratch_AddPreset}" Padding="8,2" Margin="6,0,0,0"
                                                Command="{Binding AddNamedCredentialPresetCommand}"
                                                AutomationProperties.AutomationId="ScratchAddPreset" />
                                    </WrapPanel>
                                    <TextBlock Text="{loc:Tr Scratch_PermissionSetsLabel}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding PermissionSetsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="72" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             ToolTip="{loc:Tr Scratch_PermissionSetsTip}"
                                             AutomationProperties.AutomationId="ScratchPermissionSets" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_FilesHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ProfileFolder}" TextWrapping="Wrap" Foreground="#555555"
                                               AutomationProperties.AutomationId="ScratchProfileFolder" />
                                    <TextBlock Text="{Binding FilesHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,4,0,6" />
                                    <WrapPanel>
                                        <Button Content="{loc:Tr Scratch_OpenFolder}" Padding="8,2" Command="{Binding OpenProfileFolderCommand}" />
                                        <Button Content="{loc:Tr Scratch_ExportProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding ExportProfileCommand}" />
                                        <Button Content="{loc:Tr Scratch_ImportProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding ImportProfileCommand}" />
                                        <Button Content="{loc:Tr Scratch_DeleteProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding AliasPreviewText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="ScratchAliasPreview" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="{loc:Tr Scratch_Run}" Padding="18,4" FontWeight="SemiBold"
                                        Command="{Binding RunCommand}"
                                        AutomationProperties.AutomationId="ScratchRun"
                                        AutomationProperties.Name="{loc:Tr Scratch_Run}" />
                                <Button Content="{loc:Tr Common_Cancel}" Padding="12,4" Margin="8,0,0,0"
                                        Command="{Binding CancelCommand}"
                                        AutomationProperties.AutomationId="ScratchCancel" />
                            </StackPanel>

                            <Border Background="#FFF8E1" BorderBrush="#E6C200" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_WarningsHeader}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#7A5B00"
                                               AutomationProperties.AutomationId="ScratchWarnings" />
                                </StackPanel>
                            </Border>

                            <Expander Header="{loc:Tr Scratch_PreviewHeader}" IsExpanded="True" Margin="0,0,0,6">
                                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas" Height="130" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="ScratchCommandPreview" />
                            </Expander>

                            <TextBlock Text="{loc:Tr Scratch_LogHeader}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        </StackPanel>

                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ScratchLog" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- プロファイル タブ -->
            <TabItem Header="{loc:Tr Scratch_TabProfiles}" AutomationProperties.AutomationId="ScratchTabProfiles">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ProfilesHint}" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:Tr Scratch_NewProfile}" Padding="10,2" Command="{Binding NewProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_SaveProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding SaveProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_ExportProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding ExportProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_ImportProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding ImportProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_DeleteProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_OpenFolder}" Padding="10,2" Margin="6,0,0,0" Command="{Binding OpenProfileFolderCommand}" />
                        <Button Content="{loc:Tr Scratch_BatchCreate}" Padding="10,2" Margin="14,0,0,0" FontWeight="SemiBold"
                                Command="{Binding BatchCreateCommand}"
                                AutomationProperties.AutomationId="ScratchBatchCreate" />
                        <TextBlock Text="{Binding BatchSelectionText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555555"
                                   AutomationProperties.AutomationId="ScratchBatchSelection" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ProfilesListHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding ProfileRows}"
                                     AutomationProperties.AutomationId="ScratchProfileList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Tr Scratch_FilesHeader}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ProfileFolder, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding FilesHint}" TextWrapping="Wrap" Foreground="#555555" />
                            <TextBlock Text="{loc:Tr Scratch_ProfilesHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 履歴タブ -->
            <TabItem Header="{loc:Tr Scratch_TabHistory}" AutomationProperties.AutomationId="ScratchTabHistory">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Tr Scratch_HistoryHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="{loc:Tr Scratch_HistoryClear}" Padding="8,2" Margin="12,0,0,0"
                                    Command="{Binding ClearHistoryCommand}"
                                    AutomationProperties.AutomationId="ScratchHistoryClear" />
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="ScratchHistoryGrid" ItemsSource="{Binding History}"
                                      SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AutomationProperties.AutomationId="ScratchHistoryGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColStarted}" Binding="{Binding StartedAtText}" Width="150" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColProfile}" Binding="{Binding ProfileName}" Width="140" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColAlias}" Binding="{Binding Alias}" Width="220" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColDevHub}" Binding="{Binding DevHub}" Width="200" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColResult}" Binding="{Binding ResultText}" Width="70" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColDuration}" Binding="{Binding DurationText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{loc:Tr Scratch_HistoryEmpty}" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_HistoryDetailHeader}" FontWeight="SemiBold" Margin="0,3,0,3" />
                        <TextBox Text="{Binding HistoryDetailText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ScratchHistoryDetail" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 別 Org からの取り込みタブ -->
            <TabItem Header="{loc:Tr Scratch_TabImport}" AutomationProperties.AutomationId="ScratchTabImport">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr Scratch_ImportSourceLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="320" ItemsSource="{Binding Orgs}"
                                      SelectedItem="{Binding SourceOrg, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      ToolTip="{loc:Tr Scratch_ImportSourceTip}"
                                      AutomationProperties.AutomationId="ScratchImportSource">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{loc:Tr Scratch_Retrieve}" Padding="12,2" Margin="10,0,0,0"
                                    Command="{Binding RetrieveCommand}"
                                    AutomationProperties.AutomationId="ScratchImportRetrieve" />
                            <Button Content="{loc:Tr Scratch_ApplyRetrieved}" Padding="12,2" Margin="6,0,0,0"
                                    Command="{Binding ApplyRetrievedCommand}"
                                    AutomationProperties.AutomationId="ScratchImportApply" />
                            <TextBlock Text="{Binding RetrieveStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555555"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="ScratchImportStatus" />
                        </StackPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="{loc:Tr Scratch_UseMetadata}" IsChecked="{Binding RetrieveUseMetadata, Mode=TwoWay}" Margin="0,0,12,0"
                                      AutomationProperties.AutomationId="ScratchImportMetadata" />
                            <CheckBox Content="{loc:Tr Scratch_UseCustomMetadata}" IsChecked="{Binding RetrieveUseCustomMetadata, Mode=TwoWay}" Margin="0,0,12,0"
                                      AutomationProperties.AutomationId="ScratchImportCustomMetadata" />
                            <CheckBox Content="{loc:Tr Scratch_UseStaticResources}" IsChecked="{Binding RetrieveUseStaticResources, Mode=TwoWay}" Margin="0,0,12,0"
                                      AutomationProperties.AutomationId="ScratchImportStaticResources" />
                            <CheckBox Content="{loc:Tr Scratch_UseConnectedApps}" IsChecked="{Binding RetrieveUseConnectedApps, Mode=TwoWay}" Margin="0,0,12,0"
                                      AutomationProperties.AutomationId="ScratchImportConnectedApps" />
                            <CheckBox Content="{loc:Tr Scratch_UseReports}" IsChecked="{Binding RetrieveUseReports, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ScratchImportReports" />
                            <CheckBox Content="{loc:Tr Scratch_UseExperienceCloud}" IsChecked="{Binding RetrieveUseExperienceCloud, Mode=TwoWay}" Margin="12,0,0,0"
                                      AutomationProperties.AutomationId="ScratchImportExperience" />
                            <CheckBox Content="{loc:Tr Scratch_UseNamedCredentials}" IsChecked="{Binding RetrieveUseNamedCredentials, Mode=TwoWay}" Margin="12,0,0,0"
                                      AutomationProperties.AutomationId="ScratchImportNamedCredentials" />
                        </WrapPanel>
                        <TextBlock Text="{loc:Tr Scratch_ImportHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ImportDiffHeader}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <Grid>
                            <DataGrid ItemsSource="{Binding RetrieveChanges}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AutomationProperties.AutomationId="ScratchImportGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColFile}" Binding="{Binding RelativePath}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColChange}" Binding="{Binding KindText}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{loc:Tr Scratch_ImportEmpty}" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsRetrieveEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ImportLogHeader}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <TextBox Text="{Binding RetrieveLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ScratchImportLog" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Shape / スナップショット タブ -->
            <TabItem Header="{loc:Tr Scratch_TabShapes}" AutomationProperties.AutomationId="ScratchTabShapes">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{loc:Tr Scratch_ShapeSection}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Scratch_ShapeHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" />
                            <WrapPanel Margin="0,4,0,4">
                                <TextBlock Text="{loc:Tr Scratch_ShapeSourceLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <ComboBox Width="240" ItemsSource="{Binding Orgs}"
                                          SelectedItem="{Binding ShapeSourceOrg, Mode=TwoWay}"
                                          ToolTip="{loc:Tr Scratch_ShapeSourceTip}"
                                          AutomationProperties.AutomationId="ScratchShapeSource">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="{loc:Tr Scratch_ShapeRefresh}" Padding="8,2" Margin="8,0,0,0"
                                        Command="{Binding RefreshShapesCommand}"
                                        AutomationProperties.AutomationId="ScratchShapeRefresh" />
                                <Button Content="{loc:Tr Scratch_ShapeCreate}" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding CreateShapeCommand}"
                                        AutomationProperties.AutomationId="ScratchShapeCreate" />
                                <Button Content="{loc:Tr Scratch_ShapeDelete}" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding DeleteShapeCommand}"
                                        AutomationProperties.AutomationId="ScratchShapeDelete" />
                                <Button Content="{loc:Tr Scratch_ShapeUse}" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding UseShapeInProfileCommand}"
                                        AutomationProperties.AutomationId="ScratchShapeUse" />
                                <TextBlock Text="{Binding ShapeStatus}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555555"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="ScratchShapeStatus" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding Shapes}"
                                      SelectedItem="{Binding SelectedShape, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AutomationProperties.AutomationId="ScratchShapeGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColShapeName}" Binding="{Binding Name}" Width="240" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColShapeId}" Binding="{Binding Id}" Width="220" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColShapeStatus}" Binding="{Binding Status}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColShapeCreated}" Binding="{Binding CreatedDate}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{loc:Tr Scratch_ShapeEmpty}" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsShapeListEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{loc:Tr Scratch_SnapshotSection}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Tr Scratch_SnapshotHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" />
                            <WrapPanel Margin="0,4,0,4">
                                <TextBlock Text="{loc:Tr Scratch_SnapshotSourceLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="240" Text="{Binding SnapshotSourceOrg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{loc:Tr Scratch_SnapshotSourceTip}"
                                         AutomationProperties.AutomationId="ScratchSnapshotSource" />
                                <TextBlock Text="{loc:Tr Scratch_SnapshotNameLabel}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <TextBox Width="180" Text="{Binding NewSnapshotName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ScratchSnapshotNewName" />
                                <TextBlock Text="{loc:Tr Scratch_SnapshotDescriptionLabel}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                <TextBox Width="220" Text="{Binding NewSnapshotDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="ScratchSnapshotDescription" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="{loc:Tr Scratch_SnapshotRefresh}" Padding="8,2" Command="{Binding RefreshSnapshotsCommand}"
                                        AutomationProperties.AutomationId="ScratchSnapshotRefresh" />
                                <Button Content="{loc:Tr Scratch_SnapshotCreate}" Padding="8,2" Margin="6,0,0,0" Command="{Binding CreateSnapshotCommand}"
                                        AutomationProperties.AutomationId="ScratchSnapshotCreate" />
                                <Button Content="{loc:Tr Scratch_SnapshotDelete}" Padding="8,2" Margin="6,0,0,0" Command="{Binding DeleteSnapshotCommand}"
                                        AutomationProperties.AutomationId="ScratchSnapshotDelete" />
                                <Button Content="{loc:Tr Scratch_SnapshotUse}" Padding="8,2" Margin="6,0,0,0" Command="{Binding UseSnapshotInProfileCommand}"
                                        AutomationProperties.AutomationId="ScratchSnapshotUse" />
                                <TextBlock Text="{Binding SnapshotStatus}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555555"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="ScratchSnapshotStatus" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid>
                            <DataGrid ItemsSource="{Binding Snapshots}"
                                      SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AutomationProperties.AutomationId="ScratchSnapshotGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColSnapshotName}" Binding="{Binding Name}" Width="240" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColSnapshotStatus}" Binding="{Binding Status}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColSnapshotExpires}" Binding="{Binding ExpirationDate}" Width="180" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColSnapshotCreated}" Binding="{Binding CreatedDate}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{loc:Tr Scratch_SnapshotEmpty}" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsSnapshotListEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

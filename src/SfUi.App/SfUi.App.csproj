    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SfUi</AssemblyName>
    <RootNamespace>SfUi.App</RootNamespace>
    <Version>0.1.0</Version>

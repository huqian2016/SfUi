<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SfUi.Avalonia.Dialogs.MessageDialog"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" IsVisible="False" />
        <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
    </StackPanel>
</Window>

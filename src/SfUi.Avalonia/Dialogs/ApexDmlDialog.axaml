<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SfUi.Avalonia.Dialogs.ApexDmlDialog"
        Title="{Binding Title}"
        Width="1000" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{Binding CancelText}" Width="110" Height="30" Margin="0,0,8,0" Click="OnCancel"
                            AutomationProperties.AutomationId="DmlCancel" />
                    <Button Content="{Binding InsertText}" Width="150" Height="30" Click="OnInsert"
                            AutomationProperties.AutomationId="DmlInsert" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#C62828" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="DmlStatus" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0">
            <Grid ColumnDefinitions="Auto,170,Auto,150,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding LabelFilter}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ObjectFilters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Margin="0,0,12,0" AutomationProperties.AutomationId="DmlFilter">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="{Binding LabelSearch}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666" />
                <TextBox Grid.Column="3" Text="{Binding ObjectSearch, Mode=TwoWay}" Margin="0,0,12,0"
                         AutomationProperties.AutomationId="DmlObjectSearch" />
                <TextBlock Grid.Column="4" Text="{Binding LabelObject}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                          AutomationProperties.AutomationId="DmlObject">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="6" Content="⟳" Padding="8,2" Margin="6,0,0,0" Command="{Binding LoadObjectsCommand}" />
            </Grid>

            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,170,Auto">
                <TextBlock Grid.Column="0" Text="{Binding LabelKind}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                          AutomationProperties.AutomationId="DmlKind">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,330,Auto,180,Auto,*" IsVisible="{Binding NeedsRecordId}">
                <TextBlock Grid.Column="0" Text="{Binding LabelRecordId}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666" />
                <TextBox Grid.Column="1" Text="{Binding RecordId, Mode=TwoWay}" AutomationProperties.AutomationId="DmlRecordId" />
                <TextBlock Grid.Column="2" Text="{Binding LabelRecordSearch}" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#666666" />
                <TextBox Grid.Column="3" Text="{Binding RecordSearch, Mode=TwoWay}" AutomationProperties.AutomationId="DmlRecordSearch" />
                <Button Grid.Column="4" Content="{Binding LoadRecordsText}" Padding="10,2" Margin="6,0,12,0"
                        Command="{Binding LoadRecordCandidatesCommand}" AutomationProperties.AutomationId="DmlLoadRecords" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding RecordCandidates}" SelectedItem="{Binding PickedRecord, Mode=TwoWay}"
                          AutomationProperties.AutomationId="DmlRecordCandidates">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <TextBlock Text="{Binding HintValue}" Foreground="#888888" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Margin="12,8,12,8" ColumnDefinitions="*,8,420">
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{Binding LabelFields}" Foreground="#666666" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding NoFieldsText}" Foreground="#777777" Margin="0,0,0,4"
                           IsVisible="{Binding !HasFields}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Fields}" AutomationProperties.AutomationId="DmlFields">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ColumnDefinitions="Auto,*,Auto,220">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              AutomationProperties.AutomationId="{Binding CheckAutomationId}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TypeText}" Foreground="#888888" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding RequiredText}" Foreground="#C62828" FontSize="11"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsSelected}"
                                                 IsVisible="{Binding !IsPicklist}"
                                                 AutomationProperties.AutomationId="{Binding ValueAutomationId}" />
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding PicklistOptions}" SelectedItem="{Binding Value, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelected}" IsVisible="{Binding IsPicklist}" />
                                        <Button Grid.Column="1" Content="⟳" Padding="6,1" Margin="4,0,0,0"
                                                IsVisible="{Binding IsLookup}"
                                                Command="{Binding $parent[Window].DataContext.LoadLookupCommand}"
                                                CommandParameter="{Binding}" />
                                        <ComboBox Grid.Column="2" Width="110" Margin="4,0,0,0" IsVisible="{Binding IsLookup}"
                                                  ItemsSource="{Binding LookupOptions}" SelectedItem="{Binding LookupSelected, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding LabelPreview}" Foreground="#666666" Margin="0,0,0,4" />
                <TextBox Text="{Binding Preview}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                         TextWrapping="NoWrap" AutomationProperties.AutomationId="DmlPreview" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>

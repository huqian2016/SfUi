<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.Avalonia"
        xmlns:vm="clr-namespace:SfUi.App.ViewModels;assembly=SfUi.Presentation"
        xmlns:core="clr-namespace:SfUi.Core;assembly=SfUi.Core"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:views="clr-namespace:SfUi.Avalonia.Views"
        x:Class="SfUi.Avalonia.Views.SourceEditorWindow"
        Title="{Binding Title}"
        Height="820" Width="1280" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock x:Name="SourceEditorStatusText" Text="{Binding StatusMessage}" Foreground="#666666" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OrgLabel}" FontWeight="SemiBold" VerticalAlignment="Center"
                           AutomationProperties.Name="Org" />
                <Button x:Name="SourceEditorReloadButton" Content="{loc:Tr SourceEditor_Refresh}" Padding="12,3" Margin="16,0,0,0"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="{loc:Tr SourceEditor_Refresh}" />
                <Button x:Name="SourceEditorNewButton" Content="{loc:Tr SourceEditor_New}" Padding="12,3" Margin="16,0,0,0"
                        IsEnabled="{Binding CanEdit}"
                        Click="NewMember_Click"
                        AutomationProperties.Name="{loc:Tr SourceEditor_New}" />
                <Button x:Name="SourceEditorDeployButton" Content="{loc:Tr SourceEditor_Deploy}" Padding="14,3" Margin="8,0,0,0"
                        FontWeight="SemiBold"
                        Command="{Binding DeployCommand}"
                        AutomationProperties.Name="{loc:Tr SourceEditor_Deploy}" />
                <Button x:Name="SourceEditorValidateButton" Content="{loc:Tr SourceEditor_Validate}" Padding="12,3" Margin="8,0,0,0"
                        Command="{Binding ValidateCommand}"
                        AutomationProperties.Name="{loc:Tr SourceEditor_Validate}" />
                <Button x:Name="SourceEditorDeleteButton" Content="{loc:Tr SourceEditor_Delete}" Padding="12,3" Margin="8,0,0,0"
                        Command="{Binding DeleteMemberCommand}"
                        AutomationProperties.Name="{loc:Tr SourceEditor_Delete}" />
                <TextBlock Text="{loc:Tr SourceEditor_FilterTip}" Margin="16,0,4,0" VerticalAlignment="Center" />
                <TextBox x:Name="SourceEditorFilterBox" Width="220" VerticalContentAlignment="Center"
                         ToolTip.Tip="{loc:Tr SourceEditor_FilterTip}"
                         Text="{Binding FilterText, Mode=TwoWay}"
                         AutomationProperties.Name="{loc:Tr SourceEditor_FilterTip}" />
                <TextBlock x:Name="SourceEditorFileStatusText" Text="{Binding FileStatusText}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0D47A1" />
                <TextBlock Text="{Binding CaretText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#666666" />
            </StackPanel>
        </Border>

        <!-- 反映エラー パネル -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6"
                IsVisible="{Binding HasDeployErrors}">
            <StackPanel>
                <TextBlock x:Name="SourceEditorErrorsHeader" Text="{Binding ErrorsHeaderText}" FontWeight="SemiBold" />
                <ListBox x:Name="SourceEditorErrorsList" MaxHeight="120" Margin="0,4,0,0"
                         ItemsSource="{Binding DeployErrors}"
                         SelectedItem="{Binding SelectedDeployError, Mode=TwoWay}"
                         AutomationProperties.Name="{Binding ErrorsHeaderText}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- メタデータ エクスプローラー + エディタ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="SourceEditorTree" ItemsSource="{Binding Groups}"
                      SelectionChanged="SourceEditorTree_SelectionChanged"
                      AutomationProperties.Name="{loc:Tr SourceEditor_Title}">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayNodeName}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="vm:SourceMemberGroupViewModel" ItemsSource="{Binding Members}">
                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" Padding="0,2" />
                    </TreeDataTemplate>
                    <DataTemplate DataType="core:SourceMemberInfo">
                        <TextBlock Text="{Binding Name}" Padding="0,1" />
                    </DataTemplate>
                </TreeView.DataTemplates>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="#EEEEEE" ResizeDirection="Columns" />

            <Grid Grid.Column="2" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TabControl x:Name="SourceEditorTabs"
                        Grid.Row="0"
                        IsVisible="{Binding HasNoGraph}"
                        ItemsSource="{Binding OpenFiles}"
                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                            <TextBlock Text="●" FontSize="10" Margin="4,0,0,0" Foreground="#D97706" VerticalAlignment="Center"
                                       IsVisible="{Binding IsDirty}" />
                            <Button Content="×" Margin="6,0,0,0" Padding="3,0" FontSize="11" VerticalAlignment="Center"
                                    Command="{Binding $parent[Window].DataContext.CloseFileCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{loc:Tr SourceEditor_CloseTip}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ae:TextEditor IsReadOnly="False"
                                       ShowLineNumbers="True"
                                       FontFamily="Consolas" FontSize="13"
                                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                                       AttachedToVisualTree="Editor_AttachedToVisualTree"
                                       DetachedFromVisualTree="Editor_DetachedFromVisualTree" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <Panel Grid.Row="0" IsVisible="{Binding HasGraph}">
                <views:FlowGraphControl x:Name="SourceEditorFlowGraph" DataContext="{Binding CurrentGraph}" />
            </Panel>

            <!-- 自動補完（Phase 5: 候補チップ。選択でカーソル位置の語を置き換え） -->
            <Border Grid.Row="1" x:Name="SourceEditorSuggestions" Background="#F7F9FC" BorderBrush="#E1E6EE" BorderThickness="0,1,0,0" Padding="8,6"
                    IsVisible="{Binding IsSuggestionsVisible}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Tr Soql_SuggestFetching}" Foreground="#888888" FontStyle="Italic"
                                   IsVisible="{Binding IsFetchingSuggestions}" />
                        <TextBlock x:Name="SourceEditorSuggestionHeader" Text="{Binding SuggestionsHeader}" FontWeight="SemiBold" Foreground="#445577" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Padding="8,2" Margin="0,0,6,6"
                                            FontFamily="Consolas"
                                            ToolTip.Tip="{Binding Description}"
                                            Click="Suggestion_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

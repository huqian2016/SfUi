<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.Avalonia"
             x:Class="SfUi.Avalonia.Views.QuickPanelView">
    <DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Quick_Title}" FontWeight="Bold" Margin="8,8,8,4"
                   ToolTip.Tip="{loc:Tr Quick_TitleTip}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr Quick_Hint}" FontSize="10"
                   Foreground="Gray" Margin="8,4,8,8" TextWrapping="Wrap" />

        <ListBox x:Name="FavoritesList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 DoubleTapped="OnItemDoubleClick"
                 KeyDown="OnListKeyDown">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip.Tip="{Binding ToolTipText}" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#007ACC"
                                VerticalAlignment="Top" Margin="0,2,6,0">
                            <TextBlock Text="{Binding SlotText}" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#007ACC" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr Quick_Run}" Click="OnExecuteClick" />
                    <MenuItem Header="{loc:Tr Quick_Remove}" Click="OnRemoveClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>

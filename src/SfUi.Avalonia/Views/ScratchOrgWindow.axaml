<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SfUi.Avalonia"
        x:Class="SfUi.Avalonia.Views.ScratchOrgWindow"
        Title="{Binding Title}"
        Height="820" Width="1320" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontSize="13">
    <DockPanel>

        <!-- 上部: Dev Hub とプロファイル（全タブで共有） -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Scratch_DevHubLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox Width="320" ItemsSource="{Binding Orgs}"
                              SelectedItem="{Binding SelectedDevHub, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip.Tip="{loc:Tr Scratch_DevHubTip}"
                              AutomationProperties.AutomationId="ScratchDevHubCombo"
                              AutomationProperties.Name="{loc:Tr Scratch_DevHubLabel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{loc:Tr Scratch_RefreshOrgs}" Margin="6,0,0,0" Padding="10,2"
                            Command="{Binding RefreshOrgsCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="{loc:Tr Scratch_RefreshOrgs}" />
                    <ProgressBar Width="70" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Margin="8,0,0,0"
                                 AutomationProperties.AutomationId="ScratchOrgLoadingBar"
                                 IsVisible="{Binding IsLoadingOrgs}" />

                    <TextBlock Text="{loc:Tr Scratch_ProfileLabel}" Margin="16,0,4,0" VerticalAlignment="Center" />
                    <ComboBox Width="220" ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip.Tip="{loc:Tr Scratch_ProfileTip}"
                              AutomationProperties.AutomationId="ScratchProfileCombo" />
                    <Button Content="{loc:Tr Scratch_NewProfile}" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding NewProfileCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.Name="{loc:Tr Scratch_NewProfile}" />
                    <Button Content="{loc:Tr Scratch_SaveProfile}" Margin="6,0,0,0" Padding="8,2"
                            Command="{Binding SaveProfileCommand}"
                            IsEnabled="{Binding CanEdit}"
                            AutomationProperties.AutomationId="ScratchSaveProfile"
                            AutomationProperties.Name="{loc:Tr Scratch_SaveProfile}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="ScratchStatus" />
            </StackPanel>
        </Border>

        <TabControl Margin="8">
            <!-- 作成タブ -->
            <TabItem Header="{loc:Tr Scratch_TabCreate}" AutomationProperties.AutomationId="ScratchTabCreate">
                <Grid Margin="4" ColumnDefinitions="400,*">
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_ParamsHeader}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Scratch_DurationLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DurationDays, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                 AutomationProperties.AutomationId="ScratchDuration" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Scratch_WaitLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WaitMinutes, Mode=TwoWay}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                 AutomationProperties.AutomationId="ScratchWait" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Scratch_AliasPatternLabel}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AliasPattern, Mode=TwoWay}"
                                                 Margin="0,0,0,4" ToolTip.Tip="{loc:Tr Scratch_AliasPatternTip}"
                                                 AutomationProperties.AutomationId="ScratchAliasPattern" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Scratch_ShapeLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OrgShapeId, Mode=TwoWay}"
                                                 ToolTip.Tip="{loc:Tr Scratch_ShapeTip}"
                                                 AutomationProperties.AutomationId="ScratchShapeId" />
                                    </Grid>
                                    <CheckBox Content="{loc:Tr Scratch_SetDefault}" IsChecked="{Binding SetDefault, Mode=TwoWay}" Margin="0,6,0,0"
                                              AutomationProperties.AutomationId="ScratchSetDefault" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_ResourcesHeader}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <CheckBox Content="{loc:Tr Scratch_UseMetadata}" IsChecked="{Binding UseMetadata, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseMetadata" />
                                    <CheckBox Content="{loc:Tr Scratch_UseCustomMetadata}" IsChecked="{Binding UseCustomMetadata, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUseCustomMetadata" />
                                    <CheckBox Content="{loc:Tr Scratch_UsePermissionSets}" IsChecked="{Binding UsePermissionSets, Mode=TwoWay}" Margin="0,0,0,3"
                                              AutomationProperties.AutomationId="ScratchUsePermissionSets" />
                                    <CheckBox Content="{loc:Tr Scratch_UseSeedData}" IsChecked="{Binding UseSeedData, Mode=TwoWay}" Margin="0,0,0,6"
                                              AutomationProperties.AutomationId="ScratchUseSeedData" />
                                    <TextBlock Text="{loc:Tr Scratch_PermissionSetsLabel}" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding PermissionSetsText, Mode=TwoWay}"
                                             Height="72" AcceptsReturn="True" TextWrapping="NoWrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ToolTip.Tip="{loc:Tr Scratch_PermissionSetsTip}"
                                             AutomationProperties.AutomationId="ScratchPermissionSets" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_FilesHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ProfileFolder}" TextWrapping="Wrap" Foreground="#555555"
                                               AutomationProperties.AutomationId="ScratchProfileFolder" />
                                    <TextBlock Text="{Binding FilesHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,4,0,6" />
                                    <WrapPanel>
                                        <Button Content="{loc:Tr Scratch_OpenFolder}" Padding="8,2" Command="{Binding OpenProfileFolderCommand}" />
                                        <Button Content="{loc:Tr Scratch_ExportProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding ExportProfileCommand}" />
                                        <Button Content="{loc:Tr Scratch_ImportProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding ImportProfileCommand}" />
                                        <Button Content="{loc:Tr Scratch_DeleteProfile}" Padding="8,2" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding AliasPreviewText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="ScratchAliasPreview" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="{loc:Tr Scratch_Run}" Padding="18,4" FontWeight="SemiBold"
                                        Command="{Binding RunCommand}"
                                        AutomationProperties.AutomationId="ScratchRun"
                                        AutomationProperties.Name="{loc:Tr Scratch_Run}" />
                                <Button Content="{loc:Tr Common_Cancel}" Padding="12,4" Margin="8,0,0,0"
                                        Command="{Binding CancelCommand}"
                                        AutomationProperties.AutomationId="ScratchCancel" />
                            </StackPanel>

                            <Border Background="#FFF8E1" BorderBrush="#E6C200" BorderThickness="1" Padding="6" Margin="0,0,0,6"
                                    IsVisible="{Binding HasWarning}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr Scratch_WarningsHeader}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#7A5B00"
                                               AutomationProperties.AutomationId="ScratchWarnings" />
                                </StackPanel>
                            </Border>

                            <Expander Header="{loc:Tr Scratch_PreviewHeader}" IsExpanded="True" Margin="0,0,0,6">
                                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas" Height="130" TextWrapping="NoWrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="ScratchCommandPreview" />
                            </Expander>

                            <TextBlock Text="{loc:Tr Scratch_LogHeader}" FontWeight="SemiBold" Margin="0,0,0,3" />
                        </StackPanel>

                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ScratchLog" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- プロファイル タブ -->
            <TabItem Header="{loc:Tr Scratch_TabProfiles}" AutomationProperties.AutomationId="ScratchTabProfiles">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ProfilesHint}" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:Tr Scratch_NewProfile}" Padding="10,2" Command="{Binding NewProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_SaveProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding SaveProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_ExportProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding ExportProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_ImportProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding ImportProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_DeleteProfile}" Padding="10,2" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
                        <Button Content="{loc:Tr Scratch_OpenFolder}" Padding="10,2" Margin="6,0,0,0" Command="{Binding OpenProfileFolderCommand}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="280,*">
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_ProfilesListHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding ProfileNames}"
                                     SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="ScratchProfileList" />
                        </DockPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Tr Scratch_FilesHeader}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ProfileFolder, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding FilesHint}" TextWrapping="Wrap" Foreground="#555555" />
                            <TextBlock Text="{loc:Tr Scratch_ProfilesHint}" TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- 履歴タブ -->
            <TabItem Header="{loc:Tr Scratch_TabHistory}" AutomationProperties.AutomationId="ScratchTabHistory">
                <Grid Margin="4" RowDefinitions="260,4,*">
                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Tr Scratch_HistoryHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="{loc:Tr Scratch_HistoryClear}" Padding="8,2" Margin="12,0,0,0"
                                    Command="{Binding ClearHistoryCommand}"
                                    AutomationProperties.AutomationId="ScratchHistoryClear" />
                        </StackPanel>
                        <Grid>
                            <DataGrid x:Name="ScratchHistoryGrid" ItemsSource="{Binding History}"
                                      SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      AutomationProperties.AutomationId="ScratchHistoryGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColStarted}" Binding="{Binding StartedAtText}" Width="150" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColProfile}" Binding="{Binding ProfileName}" Width="140" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColAlias}" Binding="{Binding Alias}" Width="220" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColDevHub}" Binding="{Binding DevHub}" Width="200" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColResult}" Binding="{Binding ResultText}" Width="70" />
                                    <DataGridTextColumn Header="{loc:Tr Scratch_ColDuration}" Binding="{Binding DurationText}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{loc:Tr Scratch_HistoryEmpty}" Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       IsVisible="{Binding IsHistoryEmpty}" />
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Scratch_HistoryDetailHeader}" FontWeight="SemiBold" Margin="0,3,0,3" />
                        <TextBox Text="{Binding HistoryDetailText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ScratchHistoryDetail" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

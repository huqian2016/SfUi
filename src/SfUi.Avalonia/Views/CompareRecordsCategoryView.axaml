<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SfUi.Avalonia.Views"
             xmlns:loc="clr-namespace:SfUi.Avalonia"
             x:Class="SfUi.Avalonia.Views.CompareRecordsCategoryView">
    <DockPanel>

        <!-- ツールバー: オブジェクト / 照合キー / 上限 / 比較実行 / 比較項目（複数選択） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{loc:Tr Compare_FieldsObjectLabel}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <AutoCompleteBox Width="260" VerticalAlignment="Top" MinimumPrefixLength="0" FilterMode="Contains"
                                 ItemsSource="{Binding Objects}"
                                 ValueMemberBinding="{Binding Display}"
                                 SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" />
                <TextBlock Text="{loc:Tr Compare_KeyFieldLabel}" VerticalAlignment="Top" Margin="12,6,4,0" />
                <ComboBox Width="190" MaxDropDownHeight="320" VerticalAlignment="Top"
                          ItemsSource="{Binding KeyFields}"
                          SelectedItem="{Binding SelectedKeyField, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Tr Compare_LimitLabel}" VerticalAlignment="Top" Margin="12,6,4,0" />
                <TextBox Width="64" VerticalAlignment="Top" Text="{Binding LimitText, Mode=TwoWay}" />
                <Button Content="{loc:Tr Compare_RunButton}" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Top"
                        Command="{Binding RunCommand}" Click="OnRunClick" />
                <Button Content="{loc:Tr Compare_DetailButton}" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Top"
                        Command="{Binding ShowDetailCommand}" IsEnabled="{Binding HasSelectedRow}"
                        ToolTip.Tip="{loc:Tr Compare_DetailTip}" />
                <Expander x:Name="FieldsExpander" Header="{loc:Tr Compare_CompareFieldsLabel}" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Width="280" MaxHeight="250">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Fields}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="2,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </Border>

        <views:CompareCategoryView />
    </DockPanel>
</UserControl>

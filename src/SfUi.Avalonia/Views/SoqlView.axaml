<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.Avalonia"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="SfUi.Avalonia.Views.SoqlView">
    <DockPanel>

        <!-- ツールバー（幅が狭いときは折り返して全ボタンを表示） -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,4">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Soql_Run}" Padding="10,2" Margin="0,2,12,2" Command="{Binding ExecuteCommand}" />
                <CheckBox Content="{loc:Tr Soql_PreferRest}" IsChecked="{Binding PreferRest}" VerticalAlignment="Center" Margin="0,2,10,2"
                          ToolTip.Tip="{loc:Tr Soql_PreferRestTip}" />
                <CheckBox Content="{loc:Tr Soql_ToolingApi}" IsChecked="{Binding UseToolingApi}" VerticalAlignment="Center" Margin="0,2,10,2" />
                <CheckBox Content="{loc:Tr Soql_AiAssist}" IsChecked="{Binding AiAssistEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,2,12,2"
                          ToolTip.Tip="{loc:Tr Soql_AiAssistTip}" />
                <Border Width="1" Height="20" VerticalAlignment="Center" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="{loc:Tr Common_HistoryLabel}" VerticalAlignment="Center" Margin="0,2,4,2" />
                <ComboBox Width="260" VerticalAlignment="Center" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          ToolTip.Tip="{loc:Tr Soql_HistoryTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="⟳" Padding="8,2" Margin="0,2,12,2" Command="{Binding RefreshHistoryCommand}"
                        ToolTip.Tip="{loc:Tr Common_RefreshTip}" />
                <Border Width="1" Height="20" VerticalAlignment="Center" Background="#CCCCCC" Margin="0,2,12,2" />
                <Button Content="{loc:Tr Common_AddFavorite}" Padding="10,2" Margin="0,2,6,2" Command="{Binding AddFavoriteCommand}" />
                <Button Content="{loc:Tr Soql_ExportCsv}" Padding="10,2" Margin="0,2,6,2" Command="{Binding ExportCsvCommand}" />
                <Button Content="{loc:Tr Soql_CopyResults}" Padding="10,2" Margin="0,2,0,2" Command="{Binding CopyResultsCommand}" />
            </WrapPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LiveCountText}" Foreground="#666666" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ae:TextEditor x:Name="SoqlEditor" Grid.Row="0"
                           FontFamily="Consolas, Menlo, monospace" FontSize="13"
                           ShowLineNumbers="True"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />

            <!-- 候補エリア（あふれた場合はスクロールバー表示） -->
            <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E1E6EE" BorderThickness="0,0,0,1" Padding="8,6"
                    IsVisible="{Binding IsSuggestionsVisible}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{loc:Tr Soql_SuggestFetching}" Foreground="#888888" FontStyle="Italic"
                                   IsVisible="{Binding IsFetchingSuggestions}" />
                        <TextBlock Text="{Binding SuggestionsHeader}" FontWeight="SemiBold" Foreground="#445577" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="132">
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" Padding="8,2" Margin="0,0,6,6"
                                            ToolTip.Tip="{Binding Description}"
                                            Click="OnSuggestionClick" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <DataGrid x:Name="SoqlGrid" Grid.Row="3"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All" />
        </Grid>
    </DockPanel>
</UserControl>

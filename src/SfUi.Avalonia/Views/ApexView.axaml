<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SfUi.Avalonia"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="SfUi.Avalonia.Views.ApexView">
    <DockPanel>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Tr Apex_Run}" Padding="10,2" Margin="0,0,12,0" Command="{Binding ExecuteCommand}" />
                <Button Content="{loc:Tr Apex_LoadFile}" Padding="10,2" Margin="0,0,6,0" Command="{Binding LoadFileCommand}" />
                <Button Content="{loc:Tr Apex_SaveFile}" Padding="10,2" Margin="0,0,12,0" Command="{Binding SaveFileCommand}" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <TextBlock Text="{loc:Tr Common_HistoryLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Width="240" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                          ToolTip.Tip="{loc:Tr Apex_HistoryTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="⟳" Padding="8,2" Margin="0,0,12,0" Command="{Binding RefreshHistoryCommand}"
                        ToolTip.Tip="{loc:Tr Common_RefreshTip}" />
                <Border Width="1" Background="#CCCCCC" Margin="0,2,12,2" />
                <Button Content="{loc:Tr Common_AddFavorite}" Padding="10,2" Margin="0,0,6,0" Command="{Binding AddFavoriteCommand}" />
                <Button Content="{loc:Tr Apex_FetchLatestLog}" Padding="10,2" Command="{Binding FetchLatestLogCommand}"
                        ToolTip.Tip="{loc:Tr Apex_FetchLatestLogTip}" />
            </StackPanel>
        </Border>

        <!-- ステータス -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="170" MinHeight="80" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <ae:TextEditor x:Name="ApexEditor" Grid.Row="0"
                           FontFamily="Consolas, Menlo, monospace" FontSize="13"
                           ShowLineNumbers="True"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto" />

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <TextBlock Grid.Row="2" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="8,6" />

            <TextBox Grid.Row="3" Text="{Binding ResultLogs}" IsReadOnly="True"
                     FontFamily="Consolas, Menlo, monospace" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     ToolTip.Tip="{loc:Tr Apex_LogsTip}" />
        </Grid>
    </DockPanel>
</UserControl>
